---
import "../styles/tailwind.css";
import SEO from "../components/public/SEO.astro";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <SEO title={title} description="不遠露營度假山莊線上預訂系統" />
  <!-- LINE LIFF SDK -->
  <script charset="utf-8" src="https://static.line-scdn.net/liff/edge/2/sdk.js" is:inline></script>
</head>
<body class="bg-slate-50 min-h-screen text-slate-800 font-sans selection:bg-amber-200 selection:text-amber-900 overscroll-none">
  <main class="w-full max-w-md mx-auto h-[100dvh] bg-white shadow-2xl overflow-hidden flex flex-col relative">
    <slot />
  </main>
</body>
</html>
