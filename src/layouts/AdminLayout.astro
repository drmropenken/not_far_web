---
import "../styles/tailwind.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | 營主管理後台</title>
</head>
<body class="bg-gray-100 min-h-screen text-gray-800 flex overflow-hidden">
  
  <!-- Mobile Header -->
  <div class="md:hidden flex items-center justify-between bg-slate-900 text-white p-4 shrink-0 fixed top-0 left-0 w-full z-40 h-16 shadow-md">
    <div class="flex items-center gap-2">
      <span class="text-xl">⛺️</span>
      <h1 class="text-lg font-bold tracking-widest text-emerald-400">不遠山莊</h1>
    </div>
    <button id="mobile-menu-btn" class="p-2 focus:outline-none text-slate-300 hover:text-white transition-colors">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
    </button>
  </div>

  <!-- Sidebar overlay for mobile -->
  <div id="sidebar-overlay" class="fixed inset-0 bg-slate-900/60 z-40 hidden md:hidden backdrop-blur-sm transition-opacity"></div>

  <!-- Sidebar -->
  <aside id="sidebar" class="w-64 bg-slate-900 text-slate-300 min-h-screen flex flex-col fixed inset-y-0 left-0 z-50 transform -translate-x-full md:translate-x-0 md:static transition-transform duration-300 ease-in-out shadow-2xl md:shadow-none font-sans">
    <div class="p-8 hidden md:block border-b border-slate-800/50">
      <div class="flex items-center gap-3 mb-1">
        <span class="text-2xl drop-shadow-md">⛺️</span>
        <h1 class="text-2xl font-bold tracking-widest text-emerald-400 drop-shadow-sm">不遠山莊</h1>
      </div>
      <p class="text-sm text-slate-500 tracking-wider font-medium ml-9">營主管理系統</p>
    </div>
    <div class="p-4 md:hidden flex justify-between items-center border-b border-slate-800 bg-slate-900 h-16">
      <h1 class="text-lg font-bold text-emerald-400 tracking-widest">系統選單</h1>
      <button id="close-sidebar-btn" class="p-2 text-slate-400 hover:text-white transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    <nav class="flex-1 px-4 py-8 space-y-3 overflow-y-auto">
      <a href="/admin" class="flex items-center gap-4 px-4 py-3.5 rounded-r-xl rounded-l-sm text-slate-300 hover:bg-slate-800 hover:text-emerald-300 transition-all group" id="nav-dashboard">
        <span class="text-xl group-hover:scale-110 transition-transform">📊</span> <span class="font-medium tracking-wide">儀表板</span>
      </a>
      <a href="/admin/orders" class="flex items-center gap-4 px-4 py-3.5 rounded-r-xl rounded-l-sm text-slate-300 hover:bg-slate-800 hover:text-emerald-300 transition-all group" id="nav-orders">
        <span class="text-xl group-hover:scale-110 transition-transform">📝</span> <span class="font-medium tracking-wide">訂單管理</span>
      </a>
      <a href="/admin/items" class="flex items-center gap-4 px-4 py-3.5 rounded-r-xl rounded-l-sm text-slate-300 hover:bg-slate-800 hover:text-emerald-300 transition-all group" id="nav-items">
        <span class="text-xl group-hover:scale-110 transition-transform">⛺️</span> <span class="font-medium tracking-wide">商品與營位</span>
      </a>
      <a href="/admin/inventory" class="flex items-center gap-4 px-4 py-3.5 rounded-r-xl rounded-l-sm text-slate-300 hover:bg-slate-800 hover:text-emerald-300 transition-all group" id="nav-inventory">
        <span class="text-xl group-hover:scale-110 transition-transform">📅</span> <span class="font-medium tracking-wide">庫存行事曆</span>
      </a>
    </nav>
    <div class="p-6 border-t border-slate-800/50">
      <button id="logout-btn" class="w-full flex items-center justify-center gap-3 px-4 py-3.5 text-rose-400 bg-slate-800/30 hover:bg-rose-500/10 hover:text-rose-300 rounded-xl transition-all font-medium tracking-wide border border-transparent hover:border-rose-500/20">
        <span>🚪</span> <span>登出系統</span>
      </button>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 flex flex-col h-screen overflow-hidden pt-16 md:pt-0 w-full relative bg-slate-50/50">
    <!-- Top Header (Desktop only) -->
    <header class="bg-white/80 backdrop-blur-xl shadow-sm h-16 hidden md:flex items-center px-10 border-b border-slate-200 z-10 sticky top-0">
      <h2 class="text-xl font-bold text-slate-800 tracking-wide">{title}</h2>
    </header>
    
    <!-- Content Area -->
    <div class="flex-1 overflow-auto p-4 md:p-8 w-full">
      <slot />
    </div>
  </main>

  <script>
    import { supabase } from "@/lib/supabase";

    // --- 管理員 Email 白名單 ---
    // 改為從環境變數讀取，這樣您就不用修改程式碼了！
    // 只要在 .env 檔案中加上 PUBLIC_ADMIN_EMAILS="您的信箱@gmail.com" 即可
    const envAdmins = import.meta.env.PUBLIC_ADMIN_EMAILS || "";
    const ADMIN_EMAILS = envAdmins.split(',').map((e: string) => e.trim());

    // 簡單的客戶端身分驗證檢查
    async function checkAuth() {
      const { data: { session } } = await supabase.auth.getSession();
      
      if (!session) {
        window.location.href = "/admin/login";
        return;
      }

      // 檢查是否為管理員白名單
      const userEmail = session.user.email;
      if (!userEmail || !ADMIN_EMAILS.includes(userEmail)) {
        await supabase.auth.signOut();
        window.location.href = "/admin/login?error=unauthorized";
      }
    }
    
    // 初始化檢查
    checkAuth();

    // 綁定登出按鈕
    const logoutBtn = document.getElementById("logout-btn");
    if (logoutBtn) {
      logoutBtn.addEventListener("click", async () => {
        await supabase.auth.signOut();
        window.location.href = "/admin/login";
      });
    }

    // 高亮當前選單
    const path = window.location.pathname;
    const activeClasses = ["bg-slate-800", "text-emerald-400", "font-bold", "border-l-4", "border-emerald-500", "shadow-sm"];
    if (path === "/admin" || path === "/admin/") {
      document.getElementById("nav-dashboard")?.classList.add(...activeClasses);
    } else if (path.includes("/admin/orders")) {
      document.getElementById("nav-orders")?.classList.add(...activeClasses);
    } else if (path.includes("/admin/items")) {
      document.getElementById("nav-items")?.classList.add(...activeClasses);
    } else if (path.includes("/admin/inventory")) {
      document.getElementById("nav-inventory")?.classList.add(...activeClasses);
    }

    // 手機版側邊欄開關邏輯
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const closeSidebarBtn = document.getElementById("close-sidebar-btn");
    const sidebar = document.getElementById("sidebar");
    const sidebarOverlay = document.getElementById("sidebar-overlay");

    function toggleSidebar() {
      if (sidebar && sidebarOverlay) {
        const isClosed = sidebar.classList.contains("-translate-x-full");
        if (isClosed) {
          sidebar.classList.remove("-translate-x-full");
          sidebarOverlay.classList.remove("hidden");
          document.body.style.overflow = "hidden"; // 避免背後滾動
        } else {
          sidebar.classList.add("-translate-x-full");
          sidebarOverlay.classList.add("hidden");
          document.body.style.overflow = "";
        }
      }
    }

    if (mobileMenuBtn) mobileMenuBtn.addEventListener("click", toggleSidebar);
    if (closeSidebarBtn) closeSidebarBtn.addEventListener("click", toggleSidebar);
    if (sidebarOverlay) sidebarOverlay.addEventListener("click", toggleSidebar);

  </script>
</body>
</html>
