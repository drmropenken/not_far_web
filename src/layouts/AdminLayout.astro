---
import "../styles/tailwind.css";

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | 營主管理後台</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body class="bg-stone-50 min-h-screen text-stone-800 flex overflow-hidden font-sans">
  
  <!-- Mobile Header -->
  <div class="md:hidden flex items-center justify-between bg-emerald-900 text-white border-b border-emerald-800 p-4 shrink-0 fixed top-0 left-0 w-full z-40 h-16 shadow-sm">
    <div class="flex items-center gap-2">
      <span class="text-xl">⛺️</span>
      <h1 class="text-xl font-bold tracking-widest text-white font-sans">不遠山莊</h1>
    </div>
    <button id="mobile-menu-btn" class="p-2 focus:outline-none text-emerald-200 hover:text-white transition-colors">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
    </button>
  </div>

  <!-- Sidebar overlay for mobile -->
  <div id="sidebar-overlay" class="fixed inset-0 bg-emerald-950/60 z-40 hidden md:hidden backdrop-blur-sm transition-opacity"></div>

  <!-- Sidebar -->
  <aside id="sidebar" class="w-56 shrink-0 bg-emerald-900 text-emerald-100/70 min-h-screen flex flex-col fixed inset-y-0 left-0 z-50 transform -translate-x-full md:translate-x-0 md:static md:ml-0 transition-all duration-300 ease-in-out shadow-2xl md:shadow-none font-sans border-r border-emerald-800">
    <div class="p-6 hidden md:block border-b border-emerald-800">
      <div class="flex items-center gap-2 mb-1">
        <span class="text-xl drop-shadow-sm">⛺️</span>
        <h1 class="text-2xl font-black tracking-widest text-white drop-shadow-sm font-sans">不遠山莊</h1>
      </div>
      <p class="text-xs text-emerald-100/80 tracking-wider font-medium ml-8 mt-1">營主管理系統</p>
    </div>
    <div class="p-4 md:hidden flex justify-between items-center border-b border-emerald-800 bg-emerald-900 h-16">
      <h1 class="text-lg font-bold text-white tracking-widest">系統選單</h1>
      <button id="close-sidebar-btn" class="p-2 text-emerald-400 hover:text-white transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    <nav class="flex-1 px-3 py-6 space-y-2 overflow-y-auto">
      <a href="/admin" class="flex items-center gap-3 px-4 py-3 rounded-r-xl rounded-l-sm text-emerald-100/80 hover:bg-emerald-800 hover:text-white transition-all group" id="nav-dashboard">
        <span class="text-lg group-hover:scale-110 transition-transform">📊</span> <span class="font-medium tracking-wide text-sm">儀表板</span>
      </a>
      <a href="/admin/orders" class="flex items-center gap-3 px-4 py-3 rounded-r-xl rounded-l-sm text-emerald-100/80 hover:bg-emerald-800 hover:text-white transition-all group" id="nav-orders">
        <span class="text-lg group-hover:scale-110 transition-transform">📝</span> <span class="font-medium tracking-wide text-sm">訂單管理</span>
      </a>
      <a href="/admin/items" class="flex items-center gap-3 px-4 py-3 rounded-r-xl rounded-l-sm text-emerald-100/80 hover:bg-emerald-800 hover:text-white transition-all group" id="nav-items">
        <span class="text-lg group-hover:scale-110 transition-transform">⛺️</span> <span class="font-medium tracking-wide text-sm">商品與營位</span>
      </a>
      <a href="/admin/discounts" class="flex items-center gap-3 px-4 py-3 rounded-r-xl rounded-l-sm text-emerald-100/80 hover:bg-emerald-800 hover:text-white transition-all group" id="nav-discounts">
        <span class="text-lg group-hover:scale-110 transition-transform">🏷️</span> <span class="font-medium tracking-wide text-sm">折扣碼管理</span>
      </a>
      <a href="/admin/inventory" class="flex items-center gap-3 px-4 py-3 rounded-r-xl rounded-l-sm text-emerald-100/80 hover:bg-emerald-800 hover:text-white transition-all group" id="nav-inventory">
        <span class="text-lg group-hover:scale-110 transition-transform">📅</span> <span class="font-medium tracking-wide text-sm">庫存行事曆</span>
      </a>
      <a href="/admin/admins" class="flex items-center gap-3 px-4 py-3 rounded-r-xl rounded-l-sm text-emerald-100/80 hover:bg-emerald-800 hover:text-white transition-all group" id="nav-admins">
        <span class="text-lg group-hover:scale-110 transition-transform">🛡️</span> <span class="font-medium tracking-wide text-sm">權限與管理員</span>
      </a>
    </nav>
    <div class="p-4 border-t border-emerald-800">
      <div class="flex items-center gap-3 px-3 py-2.5 mb-3 rounded-xl bg-emerald-950/50 border border-emerald-800/50">
        <div class="w-8 h-8 rounded-full bg-emerald-700 flex items-center justify-center text-emerald-100 font-bold border border-emerald-600 shrink-0" id="user-avatar">
          👤
        </div>
        <div class="overflow-hidden flex-1">
          <p id="user-name-display" class="text-sm font-bold text-white truncate">載入中...</p>
          <p id="user-email-display" class="text-xs text-emerald-100/70 truncate">...</p>
        </div>
      </div>
      <button id="logout-btn" class="w-full flex items-center justify-center gap-2 px-4 py-2.5 text-emerald-100/80 bg-emerald-950/30 hover:bg-rose-500/10 hover:text-rose-300 rounded-xl transition-all font-medium tracking-wide border border-transparent hover:border-rose-500/20 text-sm">
        <span>🚪</span> <span>登出系統</span>
      </button>
    </div>
  </aside>

  <main class="flex-1 flex flex-col h-screen overflow-hidden pt-16 md:pt-0 w-full relative bg-stone-50">
    <!-- Top Header (Desktop only) -->
    <header class="bg-white/80 backdrop-blur-xl shadow-sm h-16 hidden md:flex items-center px-6 border-b border-stone-200 z-40 sticky top-0 gap-4">
      <button id="desktop-menu-btn" class="p-2 text-stone-400 hover:text-emerald-700 transition-colors rounded-lg hover:bg-stone-100">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
      <div class="flex items-center gap-2">
        <h2 class="text-xl font-bold text-stone-800 tracking-wide">{title}</h2>
        {description && (
          <div class="relative group flex items-center">
            <div class="w-5 h-5 rounded-full bg-stone-100 hover:bg-stone-200 text-stone-400 hover:text-stone-600 flex items-center justify-center cursor-help transition-colors border border-stone-200 ml-1">
              <span class="font-bold text-xs">?</span>
            </div>
            <div class="absolute top-full -left-2 mt-3 w-72 bg-white text-stone-700 text-xs leading-relaxed p-3.5 rounded-xl shadow-xl border border-stone-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50 pointer-events-none origin-top-left before:content-[''] before:absolute before:bottom-full before:left-[12px] before:border-[6px] before:border-transparent before:border-b-white">
              {description}
            </div>
          </div>
        )}
      </div>
    </header>
    
    <!-- Content Area -->
    <div class="flex-1 overflow-auto p-4 md:p-8 w-full">
      <slot />
    </div>
  </main>

  <script>
    import { supabase } from "@/lib/supabase";

    // 簡單的客戶端身分驗證檢查
    async function checkAuth() {
      const { data: { session } } = await supabase.auth.getSession();
      
      if (!session) {
        window.location.href = "/admin/login";
        return;
      }

      // 檢查是否為管理員白名單 (從資料庫動態查詢)
      const userEmail = session.user.email;
      if (!userEmail) {
        await supabase.auth.signOut();
        window.location.href = "/admin/login?error=unauthorized";
        return;
      }

      const { data: adminRecord, error: adminError } = await supabase
        .from('nf_admins')
        .select('role')
        .eq('email', userEmail.toLowerCase())
        .single();

      if (adminError || !adminRecord) {
        console.error('Auth Error:', adminError, 'Email:', userEmail);
        await supabase.auth.signOut();
        window.location.href = "/admin/login?error=unauthorized";
        return;
      }

      // 將角色存入 localStorage 供其他前端元件判斷是否隱藏編輯按鈕
      localStorage.setItem('admin_role', adminRecord.role);

      // 渲染使用者資訊
      const userNameDisplay = document.getElementById("user-name-display");
      const userEmailDisplay = document.getElementById("user-email-display");
      const userAvatar = document.getElementById("user-avatar");

      if (userNameDisplay) {
        userNameDisplay.textContent = session.user.user_metadata?.full_name || session.user.user_metadata?.name || '營區管理員';
      }
      if (userEmailDisplay) {
        userEmailDisplay.textContent = userEmail;
      }
      if (userAvatar && session.user.user_metadata?.avatar_url) {
        userAvatar.innerHTML = `<img src="${session.user.user_metadata.avatar_url}" alt="Avatar" class="w-full h-full rounded-full object-cover" />`;
      }
    }
    
    // 初始化檢查
    checkAuth();

    // 綁定登出按鈕
    const logoutBtn = document.getElementById("logout-btn");
    if (logoutBtn) {
      logoutBtn.addEventListener("click", async () => {
        await supabase.auth.signOut();
        window.location.href = "/admin/login";
      });
    }

    // 高亮當前選單
    const path = window.location.pathname;
    const activeClasses = ["bg-emerald-800", "text-white", "font-bold", "border-l-4", "border-emerald-400", "shadow-sm"];
    if (path === "/admin" || path === "/admin/") {
      document.getElementById("nav-dashboard")?.classList.add(...activeClasses);
    } else if (path.includes("/admin/orders")) {
      document.getElementById("nav-orders")?.classList.add(...activeClasses);
    } else if (path.includes("/admin/items")) {
      document.getElementById("nav-items")?.classList.add(...activeClasses);
    } else if (path.includes("/admin/inventory")) {
      document.getElementById("nav-inventory")?.classList.add(...activeClasses);
    }

    // 側邊欄開關邏輯
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const closeSidebarBtn = document.getElementById("close-sidebar-btn");
    const sidebar = document.getElementById("sidebar");
    const sidebarOverlay = document.getElementById("sidebar-overlay");
    const desktopMenuBtn = document.getElementById("desktop-menu-btn");

    function openMobileSidebar() {
      sidebar?.classList.remove("-translate-x-full");
      sidebarOverlay?.classList.remove("hidden");
    }

    function closeMobileSidebar() {
      sidebar?.classList.add("-translate-x-full");
      sidebarOverlay?.classList.add("hidden");
    }

    mobileMenuBtn?.addEventListener("click", openMobileSidebar);
    closeSidebarBtn?.addEventListener("click", closeMobileSidebar);
    sidebarOverlay?.addEventListener("click", closeMobileSidebar);

    desktopMenuBtn?.addEventListener("click", () => {
      sidebar?.classList.toggle("md:ml-0");
      sidebar?.classList.toggle("md:-ml-56");
    });
  </script>
</body>
</html>
