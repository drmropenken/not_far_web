---
import "../styles/tailwind.css";

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | 營主管理後台</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
  <style is:global>
    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
  </style>
</head>
<body class="bg-stone-50 min-h-screen text-stone-800 flex overflow-hidden font-sans">
  
  <!-- Mobile Header -->
  <div class="md:hidden flex items-center justify-between bg-emerald-900 text-white border-b border-emerald-800 p-4 shrink-0 fixed top-0 left-0 w-full z-40 h-16 shadow-sm">
    <div class="flex items-center gap-2">
      <span class="text-xl">⛺️</span>
      <h1 class="text-xl font-bold tracking-widest text-white font-sans">不遠山莊</h1>
    </div>
    <button id="mobile-menu-btn" class="p-2 focus:outline-none text-emerald-200 hover:text-white transition-colors">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
    </button>
  </div>

  <!-- Sidebar overlay for mobile -->
  <div id="sidebar-overlay" class="fixed inset-0 bg-emerald-950/60 z-40 hidden md:hidden backdrop-blur-sm transition-opacity"></div>

  <!-- Sidebar -->
  <aside id="sidebar" class="w-56 shrink-0 bg-emerald-900 text-emerald-100/70 h-screen max-h-screen flex flex-col fixed inset-y-0 left-0 z-50 transform -translate-x-full md:translate-x-0 md:sticky md:top-0 transition-all duration-300 ease-in-out shadow-2xl md:shadow-none font-sans border-r border-emerald-800">
    <div class="p-4 hidden md:block border-b border-emerald-800 shrink-0">
      <div class="flex items-center gap-2 mb-0.5">
        <span class="text-lg drop-shadow-sm">⛺️</span>
        <h1 id="camp-name-display" class="text-lg font-black tracking-widest text-white drop-shadow-sm font-sans text-balance">載入中...</h1>
      </div>
      <p class="text-[11px] text-emerald-100/70 tracking-wider font-medium ml-6">營主管理系統</p>
    </div>
    <div class="p-3.5 md:hidden flex justify-between items-center border-b border-emerald-800 bg-emerald-900 h-14 shrink-0">
      <h1 class="text-base font-bold text-white tracking-widest">系統選單</h1>
      <button id="close-sidebar-btn" class="p-1.5 text-emerald-400 hover:text-white transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    <nav class="flex-1 px-2.5 py-3 space-y-1 overflow-y-auto min-h-0 hide-scrollbar">
      <a href="/admin" class="flex items-center gap-3 px-3.5 py-2 rounded-r-xl rounded-l-sm text-emerald-100/80 hover:bg-emerald-800 hover:text-white transition-all group" id="nav-dashboard">
        <span class="text-base group-hover:scale-110 transition-transform">📊</span> <span class="font-medium tracking-wide text-sm">儀表板</span>
      </a>
      <a href="/admin/orders" class="flex items-center gap-3 px-3.5 py-2 rounded-r-xl rounded-l-sm text-emerald-100/80 hover:bg-emerald-800 hover:text-white transition-all group" id="nav-orders">
        <span class="text-base group-hover:scale-110 transition-transform">📝</span> <span class="font-medium tracking-wide text-sm">訂單管理</span>
      </a>
      <a href="/admin/items" class="flex items-center gap-3 px-3.5 py-2 rounded-r-xl rounded-l-sm text-emerald-100/80 hover:bg-emerald-800 hover:text-white transition-all group" id="nav-items">
        <span class="text-base group-hover:scale-110 transition-transform">⛺️</span> <span class="font-medium tracking-wide text-sm">商品與營位</span>
      </a>
      <a href="/admin/discounts" class="flex items-center gap-3 px-3.5 py-2 rounded-r-xl rounded-l-sm text-emerald-100/80 hover:bg-emerald-800 hover:text-white transition-all group" id="nav-discounts">
        <span class="text-base group-hover:scale-110 transition-transform">🏷️</span> <span class="font-medium tracking-wide text-sm">折扣碼管理</span>
      </a>
      <a href="/admin/inventory" class="flex items-center gap-3 px-3.5 py-2 rounded-r-xl rounded-l-sm text-emerald-100/80 hover:bg-emerald-800 hover:text-white transition-all group" id="nav-inventory">
        <span class="text-base group-hover:scale-110 transition-transform">📅</span> <span class="font-medium tracking-wide text-sm">庫存行事曆</span>
      </a>
      <a href="/admin/admins" class="flex items-center gap-3 px-3.5 py-2 rounded-r-xl rounded-l-sm text-emerald-100/80 hover:bg-emerald-800 hover:text-white transition-all group" id="nav-admins">
        <span class="text-base group-hover:scale-110 transition-transform">🛡️</span> <span class="font-medium tracking-wide text-sm">權限與管理員</span>
      </a>
      <a href="/admin/camp-settings" class="flex items-center gap-3 px-3.5 py-2 rounded-r-xl rounded-l-sm text-emerald-100/80 hover:bg-emerald-800 hover:text-white transition-all group" id="nav-camp-settings">
        <span class="text-base group-hover:scale-110 transition-transform">⚙️</span> <span class="font-medium tracking-wide text-sm">營區設定</span>
      </a>
    </nav>
    <div class="p-3 border-t border-emerald-800 flex flex-col gap-1.5 shrink-0 bg-emerald-900">
      <div class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-emerald-950/50 border border-emerald-800/50">
        <div class="w-7 h-7 rounded-full bg-emerald-700 flex items-center justify-center text-emerald-100 font-bold border border-emerald-600 shrink-0 text-xs" id="user-avatar">
          👤
        </div>
        <div class="overflow-hidden flex-1">
          <p id="user-name-display" class="text-xs font-bold text-white truncate">載入中...</p>
          <p id="user-email-display" class="text-[10px] text-emerald-100/70 truncate">...</p>
        </div>
      </div>
      <button id="switch-camp-btn" class="w-full flex items-center justify-center gap-1.5 px-3 py-1.5 text-emerald-100/80 bg-emerald-950/30 hover:bg-emerald-800/50 hover:text-white rounded-xl transition-all font-medium border border-transparent hover:border-emerald-700/30 text-xs">
        <span>🔄</span> <span>切換營區</span>
      </button>
      <button id="logout-btn" class="w-full flex items-center justify-center gap-1.5 px-3 py-1.5 text-emerald-100/80 bg-emerald-950/30 hover:bg-rose-500/10 hover:text-rose-300 rounded-xl transition-all font-medium border border-transparent hover:border-rose-500/20 text-xs">
        <span>🚪</span> <span>登出系統</span>
    </div>
  </aside>

  <main class="flex-1 flex flex-col h-screen overflow-hidden pt-16 md:pt-0 w-full relative bg-stone-50">
    <!-- Top Header (Desktop only) -->
    <header class="bg-white/80 backdrop-blur-xl shadow-sm h-16 hidden md:flex items-center px-6 border-b border-stone-200 z-40 sticky top-0 gap-4">
      <button id="desktop-menu-btn" class="p-2 text-stone-400 hover:text-emerald-700 transition-colors rounded-lg hover:bg-stone-100">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
      <div class="flex items-center gap-2">
        <h2 class="text-xl font-bold text-stone-800 tracking-wide">{title}</h2>
        {description && (
          <div class="relative group flex items-center">
            <div class="w-5 h-5 rounded-full bg-stone-100 hover:bg-stone-200 text-stone-400 hover:text-stone-600 flex items-center justify-center cursor-help transition-colors border border-stone-200 ml-1">
              <span class="font-bold text-xs">?</span>
            </div>
            <div class="absolute top-full -left-2 mt-3 w-72 bg-white text-stone-700 text-xs leading-relaxed p-3.5 rounded-xl shadow-xl border border-stone-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50 pointer-events-none origin-top-left before:content-[''] before:absolute before:bottom-full before:left-[12px] before:border-[6px] before:border-transparent before:border-b-white">
              {description}
            </div>
          </div>
        )}
      </div>
    </header>
    
    <!-- Content Area -->
    <div class="flex-1 overflow-auto p-4 md:p-8 w-full">
      <slot />
    </div>
  </main>

  <script>
    import { supabase } from "@/lib/supabase";

    // 簡單的客戶端身分驗證檢查
    async function checkAuth() {
      // 🔑 處理 Google OAuth 回傳 Hash（與 BookingFlow 同樣邏輯）
      const hash = window.location.hash;
      if (hash.includes('access_token') && hash.includes('refresh_token')) {
        try {
          const hashParams = new URLSearchParams(hash.substring(1));
          const accessToken = hashParams.get('access_token');
          const refreshToken = hashParams.get('refresh_token');
          if (accessToken && refreshToken) {
            await supabase.auth.setSession({ access_token: accessToken, refresh_token: refreshToken });
            window.history.replaceState(null, '', window.location.pathname);
          }
        } catch (err) {
          console.error('Admin OAuth hash handling error:', err);
        }
      }

      const { data: { session } } = await supabase.auth.getSession();
      
      if (!session) {
        window.location.href = "/admin/login";
        return;
      }

      // 檢查是否為管理員白名單 (從資料庫動態查詢)
      const userEmail = session.user.email;
      if (!userEmail) {
        await supabase.auth.signOut();
        window.location.href = "/admin/login?error=unauthorized";
        return;
      }

      // 查詢該 Email 的所有管理員紀錄（同一個 Email 可有多筆，綁不同 camp_id）
      const { data: adminRecords, error: adminError } = await supabase
        .from('nf_admins')
        .select('role, camp_id')
        .eq('email', userEmail.toLowerCase());

      if (adminError || !adminRecords || adminRecords.length === 0) {
        console.error('Auth Error:', adminError, 'Email:', userEmail);
        await supabase.auth.signOut();
        window.location.href = "/admin/login?error=unauthorized";
        return;
      }

      // 收集該管理員可存取的 camp_id 列表
      const campIds = adminRecords.map(r => r.camp_id).filter(Boolean);
      const hasNullAccess = adminRecords.some(r => r.camp_id === null);

      // 儲存角色、Email、可存取的營區 ID 列表
      localStorage.setItem('admin_role', adminRecords[0].role);
      localStorage.setItem('admin_email', userEmail);
      localStorage.setItem('admin_camp_ids', JSON.stringify(campIds));
      localStorage.setItem('admin_has_null_access', hasNullAccess ? 'true' : 'false');

      const currentPath = window.location.pathname;

      // 檢查 URL 是否帶有 camp_id 參數（例如從車泊地圖 SSO 跳轉過來）
      const urlParams = new URLSearchParams(window.location.search);
      const urlCampId = urlParams.get('camp_id');

      if (urlCampId && (hasNullAccess || campIds.includes(urlCampId))) {
        localStorage.setItem('camp_id', urlCampId);
        const { data: camp } = await supabase
          .from('nf_campgrounds')
          .select('name')
          .eq('id', urlCampId)
          .single();
        if (camp) localStorage.setItem('camp_name', camp.name);

        if (currentPath === '/admin/campgrounds' || currentPath === '/admin' || currentPath === '/admin/') {
          window.location.href = '/admin/orders';
          return;
        }
      }

      const existingCampId = localStorage.getItem('camp_id');

      // 如果還沒選營區且不在選單頁 → 導去選
      if (!existingCampId && !currentPath.includes('/admin/campgrounds')) {
        window.location.href = '/admin/campgrounds';
        return;
      }

      // 如果有選過，確保 camp_name 存在
      if (existingCampId) {
        const storedName = localStorage.getItem('camp_name');
        if (!storedName) {
          const { data: camp } = await supabase
            .from('nf_campgrounds')
            .select('name')
            .eq('id', existingCampId)
            .single();
          if (camp) localStorage.setItem('camp_name', camp.name);
        }
      }

      // 渲染使用者資訊
      const userNameDisplay = document.getElementById("user-name-display");
      const userEmailDisplay = document.getElementById("user-email-display");
      const userAvatar = document.getElementById("user-avatar");

      if (userNameDisplay) {
        userNameDisplay.textContent = session.user.user_metadata?.full_name || session.user.user_metadata?.name || '營區管理員';
      }
      if (userEmailDisplay) {
        userEmailDisplay.textContent = userEmail;
      }
      if (userAvatar && session.user.user_metadata?.avatar_url) {
        userAvatar.innerHTML = `<img src="${session.user.user_metadata.avatar_url}" alt="Avatar" class="w-full h-full rounded-full object-cover" />`;
      }

      // 顯示營區名稱
      const campNameDisplay = document.getElementById('camp-name-display');
      if (campNameDisplay) {
        const campName = localStorage.getItem('camp_name');
        campNameDisplay.textContent = campName || '選擇營區';
      }

      // 在網址列顯示 camp_id（不重新載入頁面）
      const currentCampId = localStorage.getItem('camp_id');
      if (currentCampId && !window.location.search.includes('camp_id=')) {
        const url = new URL(window.location.href);
        url.searchParams.set('camp_id', currentCampId);
        window.history.replaceState({}, '', url.toString());
      }
    }
    
    // 初始化檢查
    checkAuth();

    // 綁定登出按鈕
    const logoutBtn = document.getElementById("logout-btn");
    if (logoutBtn) {
      logoutBtn.addEventListener("click", async () => {
        await supabase.auth.signOut();
        window.location.href = "/admin/login";
      });
    }

    // 綁定切換營區按鈕（所有人都可以按）
    const switchCampBtn = document.getElementById("switch-camp-btn");
    if (switchCampBtn) {
      switchCampBtn.addEventListener("click", () => {
        localStorage.removeItem('camp_id');
        localStorage.removeItem('camp_name');
        window.location.href = "/admin/campgrounds";
      });
    }

    // 高亮當前選單
    const path = window.location.pathname;
    const activeClasses = ["bg-emerald-800", "text-white", "font-bold", "border-l-4", "border-emerald-400", "shadow-sm"];
    if (path === "/admin" || path === "/admin/") {
      document.getElementById("nav-dashboard")?.classList.add(...activeClasses);
    } else if (path.includes("/admin/orders")) {
      document.getElementById("nav-orders")?.classList.add(...activeClasses);
    } else if (path.includes("/admin/items")) {
      document.getElementById("nav-items")?.classList.add(...activeClasses);
    } else if (path.includes("/admin/inventory")) {
      document.getElementById("nav-inventory")?.classList.add(...activeClasses);
    }

    // 側邊欄開關邏輯
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const closeSidebarBtn = document.getElementById("close-sidebar-btn");
    const sidebar = document.getElementById("sidebar");
    const sidebarOverlay = document.getElementById("sidebar-overlay");
    const desktopMenuBtn = document.getElementById("desktop-menu-btn");

    function openMobileSidebar() {
      sidebar?.classList.remove("-translate-x-full");
      sidebarOverlay?.classList.remove("hidden");
    }

    function closeMobileSidebar() {
      sidebar?.classList.add("-translate-x-full");
      sidebarOverlay?.classList.add("hidden");
    }

    mobileMenuBtn?.addEventListener("click", openMobileSidebar);
    closeSidebarBtn?.addEventListener("click", closeMobileSidebar);
    sidebarOverlay?.addEventListener("click", closeMobileSidebar);

    desktopMenuBtn?.addEventListener("click", () => {
      sidebar?.classList.toggle("md:ml-0");
      sidebar?.classList.toggle("md:-ml-56");
    });
  </script>
</body>
</html>
