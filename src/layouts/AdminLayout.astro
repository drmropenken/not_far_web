---
import "../styles/tailwind.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | 營主管理後台</title>
</head>
<body class="bg-gray-100 min-h-screen text-gray-800 flex">
  
  <!-- Sidebar -->
  <aside class="w-64 bg-gray-900 text-white min-h-screen flex flex-col">
    <div class="p-6">
      <h1 class="text-xl font-bold tracking-wider">🏕️ 營主管理後台</h1>
    </div>
    <nav class="flex-1 px-4 space-y-2">
      <a href="/admin" class="block px-4 py-3 rounded-lg hover:bg-gray-800 transition-colors" id="nav-dashboard">📊 儀表板</a>
      <a href="/admin/orders" class="block px-4 py-3 rounded-lg hover:bg-gray-800 transition-colors" id="nav-orders">📝 訂單管理</a>
      <a href="/admin/items" class="block px-4 py-3 rounded-lg hover:bg-gray-800 transition-colors" id="nav-items">⛺️ 商品與營位</a>
      <a href="/admin/inventory" class="block px-4 py-3 rounded-lg hover:bg-gray-800 transition-colors" id="nav-inventory">📅 庫存行事曆</a>
    </nav>
    <div class="p-4 border-t border-gray-800">
      <button id="logout-btn" class="w-full text-left px-4 py-2 text-red-400 hover:bg-gray-800 rounded-lg transition-colors">
        🚪 登出系統
      </button>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 flex flex-col h-screen overflow-hidden">
    <!-- Top Header -->
    <header class="bg-white shadow-sm h-16 flex items-center px-8">
      <h2 class="text-xl font-semibold text-gray-800">{title}</h2>
    </header>
    
    <!-- Content Area -->
    <div class="flex-1 overflow-auto p-8">
      <slot />
    </div>
  </main>

  <script>
    import { supabase } from "@/lib/supabase";

    // --- 管理員 Email 白名單 ---
    // 改為從環境變數讀取，這樣您就不用修改程式碼了！
    // 只要在 .env 檔案中加上 PUBLIC_ADMIN_EMAILS="您的信箱@gmail.com" 即可
    const envAdmins = import.meta.env.PUBLIC_ADMIN_EMAILS || "";
    const ADMIN_EMAILS = envAdmins.split(',').map((e: string) => e.trim());

    // 簡單的客戶端身分驗證檢查
    async function checkAuth() {
      const { data: { session } } = await supabase.auth.getSession();
      
      if (!session) {
        window.location.href = "/admin/login";
        return;
      }

      // 檢查是否為管理員白名單
      const userEmail = session.user.email;
      if (!userEmail || !ADMIN_EMAILS.includes(userEmail)) {
        await supabase.auth.signOut();
        window.location.href = "/admin/login?error=unauthorized";
      }
    }
    
    // 初始化檢查
    checkAuth();

    // 綁定登出按鈕
    const logoutBtn = document.getElementById("logout-btn");
    if (logoutBtn) {
      logoutBtn.addEventListener("click", async () => {
        await supabase.auth.signOut();
        window.location.href = "/admin/login";
      });
    }

    // 高亮當前選單
    const path = window.location.pathname;
    if (path === "/admin" || path === "/admin/") {
      document.getElementById("nav-dashboard")?.classList.add("bg-gray-800", "text-green-400");
    } else if (path.includes("/admin/orders")) {
      document.getElementById("nav-orders")?.classList.add("bg-gray-800", "text-green-400");
    } else if (path.includes("/admin/items")) {
      document.getElementById("nav-items")?.classList.add("bg-gray-800", "text-green-400");
    } else if (path.includes("/admin/inventory")) {
      document.getElementById("nav-inventory")?.classList.add("bg-gray-800", "text-green-400");
    }
  </script>
</body>
</html>
