---
import SEO from "../components/public/SEO.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="zh-TW">
  <head>
  <SEO 
    title="聯絡我們 - 不遠露營度假山莊" 
    description="" 
  />
</head>
  <body>
    <!-- Navbar -->
    <nav class="navbar" id="navbar">
      <div class="container">
        <a href="/" class="logo">
          <span>🏕️</span>
          <span>不遠山莊</span>
        </a>
        <div class="nav-links">
          <a href="/">首頁</a>
          <a href="/about">關於我們</a>
          <a href="/campsite">營區介紹</a>
          <a href="/gallery">圖庫</a>
          <a href="/faq">常見問題</a>
          <a href="/contact" class="active">聯絡我們</a>
        <a href="/equipment">裝備推薦</a>
          <a href="/app" class="btn btn-primary">立即預訂</a>
        </div>
        <div class="hamburger">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    </nav>

    <!-- Page Header -->
    <section class="page-header">
      <div class="container">
        <h1>聯絡我們</h1>
        <p>有任何問題或需要協助？我們很樂意為您服務</p>
      </div>
    </section>

    <!-- 聯絡資訊與表單 -->
    <section class="section">
      <div class="container">
        <div class="contact-grid">
          <div class="contact-info">
            <h2
              style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 8px;"
            >
              📞 聯絡資訊
            </h2>
            <p style="color: var(--text-light); margin-bottom: 16px;">
              歡迎透過以下方式與我們聯繫，我們將盡快回覆您
            </p>

            <div class="contact-item fade-in">
              <div class="icon">📞</div>
              <div>
                <h4>預約專線</h4>
                <p>
                  <a
                    href="tel:+886911233810"
                    style="color: var(--primary); font-size: 1.2rem; font-weight: 600;"
                    >0911-233-810</a>
                </p>
                <p style="font-size: 0.85rem;">服務時間：每日 09:00 - 21:00</p>
              </div>
            </div>

            <div class="contact-item fade-in">
              <div class="icon">📞</div>
              <div>
                <h4>市話專線</h4>
                <p>
                  <a
                    href="tel:+88637870898"
                    style="color: var(--primary); font-size: 1.2rem; font-weight: 600;"
                    >037-870-898</a>
                </p>
              </div>
            </div>

            <div class="contact-item fade-in">
              <div class="icon">📍</div>
              <div>
                <h4>地址</h4>
                <p>苗栗縣三義鄉雙連潭9鄰199號</p>
                <p style="font-size: 0.85rem;">
                  國道一號三義交流道下約15分鐘車程
                </p>
              </div>
            </div>

            <div class="contact-item fade-in">
              <div class="icon">💬</div>
              <div>
                <h4>Line 官方帳號</h4>
                <p>
                  <a
                    href="https://line.me/ti/p/@paq1032x"
                    target="_blank"
                    style="color: var(--primary);">@paq1032x</a>
                </p>
                <p style="font-size: 0.85rem;">點擊加入好友，即時諮詢</p>
              </div>
            </div>

            <div class="contact-item fade-in">
              <div class="icon">📘</div>
              <div>
                <h4>Facebook 粉絲專頁</h4>
                <p>
                  <a
                    href="https://www.facebook.com/close2camp"
                    target="_blank"
                    style="color: var(--primary);">不遠露營度假山莊</a>
                </p>
              </div>
            </div>
          </div>

          <div>
            <h2
              style="font-size: 1.8rem; color: var(--primary-dark); margin-bottom: 24px;"
            >
              📝 傳送訊息
            </h2>

            <form
              id="contactForm"
              class="glass-card"
              style="padding: 32px;"
              data-custom-handler="true"
            >
              <div class="form-group">
                <label for="contactName">姓名 *</label>
                <input
                  type="text"
                  id="contactName"
                  name="name"
                  placeholder="請輸入您的姓名"
                  required
                />
              </div>

              <div class="form-group">
                <label for="contactPhone">電話</label>
                <input
                  type="tel"
                  id="contactPhone"
                  name="phone"
                  placeholder="例如：0912-345-678"
                />
              </div>

              <div class="form-group">
                <label for="contactEmail">電子郵件 *</label>
                <input
                  type="email"
                  id="contactEmail"
                  name="email"
                  placeholder="example@email.com"
                  required
                />
              </div>

              <div class="form-group">
                <label for="contactSubject">主旨</label>
                <select id="contactSubject" name="subject">
                  <option value="booking">預訂諮詢</option>
                  <option value="price">價格詢問</option>
                  <option value="facility">設施問題</option>
                  <option value="feedback">意見回饋</option>
                  <option value="other">其他</option>
                </select>
              </div>

              <div class="form-group">
                <label for="contactMessage">訊息內容 *</label>
                <textarea
                  id="contactMessage"
                  name="message"
                  placeholder="請詳細描述您的問題或需求..."
                  required></textarea>
              </div>

              <button
                type="submit"
                class="btn btn-primary"
                style="width: 100%; justify-content: center; padding: 16px; font-size: 1.1rem;"
              >
                📤 送出訊息
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- 地圖 -->
    <section class="section" style="background: #f0f7f4; padding-bottom: 0;">
      <div class="container">
        <h2 class="section-title">找到我們</h2>
        <p class="section-subtitle">苗栗縣三義鄉雙連潭9鄰199號</p>

        <div
          style="border-radius: var(--radius); overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.1);"
        >
          <iframe
            src="https://maps.google.com/maps?q=%E4%B8%8D%E9%81%A0%E9%9C%B2%E7%87%9F%E5%BA%A6%E5%81%87%E5%B1%B1%E8%8E%8A&t=&z=15&ie=UTF8&iwloc=&output=embed"
            width="100%"
            height="450"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
          >
          </iframe>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <h3>🏕️ 不遠露營度假山莊</h3>
            <p>
              前身為退役礦場，歷經生態再造，如今成為占地 3.5 公頃的綠色天堂。
            </p>
            <div class="social-links">
              <a
                href="https://www.facebook.com/close2camp"
                target="_blank"
                title="Facebook">📘</a
              >
              <a
                href="https://www.instagram.com/"
                target="_blank"
                title="Instagram">📷</a
              >
              <a
                href="https://line.me/ti/p/@paq1032x"
                target="_blank"
                title="Line">💬</a
              >
              <a href="https://www.youtube.com/" target="_blank" title="YouTube"
                >▶️</a
              >
            </div>
          </div>
          <div>
            <h3>快速連結</h3>
            <div class="footer-links">
              <a href="/about">關於我們</a>
              <a href="/campsite">營區介紹</a>
              <a href="/gallery">圖庫</a>
              <a href="/faq">常見問題</a>
            </div>
          </div>
          <div>
            <h3>服務項目</h3>
            <div class="footer-links">
              <a href="/app">線上預訂</a>
              <a href="/campsite#accommodation">住宿選擇</a>
              <a href="/contact">聯絡我們</a>
        <a href="/equipment">裝備推薦</a>
            </div>
          </div>
          <div>
            <h3>聯絡資訊</h3>
            <div class="footer-links">
              <a href="tel:+886911233810"><span class="shrink-0">📞</span> <span>0911-233-810</span></a>
              <a href="tel:+88637870898"><span class="shrink-0">📞</span> <span>037-870-898</span></a>

              <a
                href="https://maps.google.com/?q=苗栗縣三義鄉雙連潭9鄰199號"
                target="_blank"><span class="shrink-0">📍</span> <span>苗栗縣三義鄉雙連潭9鄰199號</span></a
              >
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© 2026 不遠露營度假山莊 · 苗栗縣民宿353號 · All Rights Reserved</p>
        </div>
      </div>
    </footer>

    <script src="/script.js" is:inline></script>
    <script>
      // 確保聯絡表單只使用一個處理器，避免與 script.js 衝突
      document.addEventListener("DOMContentLoaded", function () {
        // 檢查是否已經有 script.js 的 initContactForm 被調用
        const contactForm = document.getElementById("contactForm");
        if (contactForm && !contactForm.dataset.handledByScript) {
          contactForm.dataset.handledByScript = "true";
          console.log("聯絡表單將由 script.js 處理");
        }
      });
    </script>
  </body>
</html>
