---
import AppLayout from "../layouts/AppLayout.astro";
import MyOrdersFlow from "../components/public/MyOrdersFlow";
import { supabase } from "../lib/supabase";

let campId = Astro.url.searchParams.get('camp_id') || '';

if (!campId) {
  const { data: defaultCamp } = await supabase
    .from('nf_campgrounds')
    .select('id')
    .eq('slug', 'not-far')
    .single();
  if (defaultCamp) {
    campId = defaultCamp.id;
    const currentParams = new URLSearchParams(Astro.url.searchParams);
    currentParams.set('camp_id', defaultCamp.id);
    return Astro.redirect(`${Astro.url.pathname}?${currentParams.toString()}`);
  }
}
---

<AppLayout title="我的訂單 - SunnyCampTW">
  <MyOrdersFlow client:only="react" campId={campId} />
</AppLayout>
