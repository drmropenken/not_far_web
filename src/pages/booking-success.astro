---
import "../styles/global.css";
---
<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>預訂成功 - 不遠露營度假山莊</title>
  <meta name="description" content="您的不遠山莊預訂已成功，感謝您使用線上預訂服務。">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
  <nav class="navbar" id="navbar">
    <div class="container">
      <a href="/" class="logo"><span>🏕️</span><span>不遠山莊</span></a>
      <div class="nav-links">
        <a href="/">首頁</a>
        <a href="/about">關於我們</a>
        <a href="/campsite">營區介紹</a>
        <a href="/gallery">圖庫</a>
        <a href="/faq">常見問題</a>
        <a href="/contact">聯絡我們</a>
        <a href="/app" class="btn btn-primary">立即預訂</a>
      </div>
      <div class="hamburger"><span></span><span></span><span></span></div>
    </div>
  </nav>

  <section class="section" style="min-height: 72vh; display: flex; align-items: center; justify-content: center;">
    <div class="glass-card" style="max-width: 720px; width: 100%; padding: 48px; text-align: center;">
      <div style="font-size: 4rem; margin-bottom: 24px;">🎉</div>
      <h1>付款完成，預訂成功！</h1>
      <p style="margin-top: 16px; color: var(--text-light);">感謝您的預訂，我們已經收到您的款項並確認了您的訂單。期待您的蒞臨！</p>
      <p id="bookingDetails" style="margin-top: 24px; font-size: 1rem; color: var(--text-dark);"></p>
      <div style="margin-top: 36px; display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;">
        <a href="/" class="btn btn-primary">回到首頁</a>
        <a href="/app" class="btn btn-outline">再次預訂</a>
      </div>
    </div>
  </section>

  <script>
    const params = new URLSearchParams(window.location.search);
    const bookingDetails = document.getElementById('bookingDetails');
    const tradeNo = params.get('order') || params.get('MerchantTradeNo') || params.get('orderNo') || '';
    if (bookingDetails) {
      bookingDetails.textContent = tradeNo
        ? `訂單編號：${tradeNo}`
        : '';
    }
  </script>
</body>
</html>
