---
import "../styles/global.css";
---
<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>價格方案 - 不遠露營度假山莊</title>
  <meta name="description" content="不遠山莊價格方案，一泊二食最低每人1250元起，提供多種優惠方案。">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
  
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar" id="navbar">
    <div class="container">
      <a href="/" class="logo">
        <span>🏕️</span>
        <span>不遠山莊</span>
      </a>
      <div class="nav-links">
        <a href="/">首頁</a>
        <a href="/about">關於我們</a>
        <a href="/campsite">營區介紹</a>
        <a href="/pricing" class="active">價格方案</a>
        <a href="/gallery">圖庫</a>
        <a href="/faq">常見問題</a>
        <a href="/contact">聯絡我們</a>
        <a href="/booking" class="btn btn-primary">立即預訂</a>
      </div>
      <div class="hamburger">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </nav>

  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <h1>價格方案</h1>
      <p>透明公開的價格，讓您輕鬆規劃完美假期</p>
    </div>
  </section>

  <!-- 住宿價格 -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">住宿價格一覽</h2>
      <p class="section-subtitle">以下價格為平日參考價，假日及連續假期可能有所調整，請以預訂時為準</p>
      
      <div class="pricing-grid">
        <div class="pricing-card fade-in">
          <h3>🏕️ 草地營位</h3>
          <div class="price">NT$ 800 <span>/ 帳</span></div>
          <ul>
            <li>自搭帳篷</li>
            <li>公共衛浴</li>
            <li>免費停車</li>
            <li>使用園區設施</li>
            <li>夜衝加收 NT$ 600</li>
          </ul>
          <a href="/booking" class="btn btn-outline" style="width: 100%;">立即預訂</a>
        </div>
        
        <div class="pricing-card fade-in">
          <h3>🛖 水管屋</h3>
          <div class="price">NT$ 2,500 <span>/ 間</span></div>
          <ul>
            <li>可住 2 人</li>
            <li>公共衛浴</li>
            <li>車位旁</li>
            <li>使用園區設施</li>
            <li>不含餐點</li>
          </ul>
          <a href="/booking" class="btn btn-outline" style="width: 100%;">立即預訂</a>
        </div>
        
        <div class="pricing-card featured fade-in">
          <span class="badge">🔥 最受歡迎</span>
          <h3>⛺ 野奢帳篷</h3>
          <div class="price">NT$ 1,250 <span>/ 人 起</span></div>
          <ul>
            <li>免裝備懶人露營</li>
            <li>一泊二食（早+晚餐）</li>
            <li>帳內有冷氣</li>
            <li>可住 2-4 人</li>
            <li>公共衛浴</li>
          </ul>
          <a href="/booking" class="btn btn-primary" style="width: 100%;">立即預訂</a>
        </div>
        
        <div class="pricing-card fade-in">
          <h3>🏡 小木屋</h3>
          <div class="price">NT$ 3,500 <span>/ 間</span></div>
          <ul>
            <li>可住 2-4 人</li>
            <li>獨立衛浴</li>
            <li>冷氣</li>
            <li>使用園區設施</li>
            <li>不含餐點</li>
          </ul>
          <a href="/booking" class="btn btn-outline" style="width: 100%;">立即預訂</a>
        </div>
        
        <div class="pricing-card fade-in">
          <h3>🧙 哈比屋</h3>
          <div class="price">NT$ 2,800 <span>/ 間</span></div>
          <ul>
            <li>限量 1 間</li>
            <li>可住 2 人</li>
            <li>湖畔旁</li>
            <li>公共衛浴</li>
            <li>不含餐點</li>
          </ul>
          <a href="/booking" class="btn btn-outline" style="width: 100%;">立即預訂</a>
        </div>
        
        <div class="pricing-card fade-in">
          <h3>🏘️ 合掌村石茅屋</h3>
          <div class="price">NT$ 6,000 <span>/ 四人房</span></div>
          <ul>
            <li>可住 2-4 人</li>
            <li>獨立衛浴</li>
            <li>冷氣</li>
            <li>一泊二食（早+晚餐）</li>
            <li>閣樓秘密基地</li>
          </ul>
          <a href="/booking" class="btn btn-outline" style="width: 100%;">立即預訂</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 優惠方案 -->
  <section class="section" style="background: #f0f7f4;">
    <div class="container">
      <h2 class="section-title">🎉 限時優惠方案</h2>
      <p class="section-subtitle">把握機會，與親朋好友一起享受超值假期</p>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
        <div class="glass-card fade-in" style="padding: 32px; text-align: center;">
          <div style="font-size: 3rem; margin-bottom: 16px;">🎪</div>
          <h3 style="color: var(--primary-dark); margin-bottom: 12px;">野奢帳篷 · 三帳送一帳</h3>
          <div style="font-size: 2rem; font-weight: 800; color: var(--primary); margin: 16px 0;">NT$ 12,000</div>
          <p style="color: var(--text-light); line-height: 1.8; margin-bottom: 16px;">
            預訂三間野奢帳篷即贈送一間！<br>
            每人一泊二食最低只要 <strong>NT$ 1,250</strong><br>
            適合好友團、家庭聚會
          </p>
          <a href="/booking" class="btn btn-primary">立即預訂</a>
        </div>
        
        <div class="glass-card fade-in" style="padding: 32px; text-align: center;">
          <div style="font-size: 3rem; margin-bottom: 16px;">🏘️</div>
          <h3 style="color: var(--primary-dark); margin-bottom: 12px;">石茅屋 · 三間送一間</h3>
          <div style="font-size: 2rem; font-weight: 800; color: var(--primary); margin: 16px 0;">NT$ 16,000</div>
          <p style="color: var(--text-light); line-height: 1.8; margin-bottom: 16px;">
            預訂三間合掌村石茅屋即贈送一間！<br>
            每人一泊二食最低只要 <strong>NT$ 1,500</strong><br>
            適合家族旅遊、公司團體
          </p>
          <a href="/booking" class="btn btn-primary">立即預訂</a>
        </div>
        
        <div class="glass-card fade-in" style="padding: 32px; text-align: center;">
          <div style="font-size: 3rem; margin-bottom: 16px;">🎫</div>
          <h3 style="color: var(--primary-dark); margin-bottom: 12px;">一泊三食一樂方案</h3>
          <div style="font-size: 2rem; font-weight: 800; color: var(--primary); margin: 16px 0;">NT$ 3,000 起</div>
          <p style="color: var(--text-light); line-height: 1.8; margin-bottom: 16px;">
            住宿 + 早餐 + 下午茶 + 晚餐<br>
            加贈鐵道自行車體驗<br>
            超值方案三千元有找！
          </p>
          <a href="/booking" class="btn btn-primary">立即預訂</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 加購服務 -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">加購服務</h2>
      <p class="section-subtitle">讓您的露營體驗更加豐富</p>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px;">
        <div class="feature-card fade-in">
          <div class="icon">🍗</div>
          <h4>南洋咖哩葉烤雞</h4>
          <p>加價 NT$ 500，享用隱藏版美食！利用大量咖哩葉悶烤，表皮金黃酥脆，雞汁鮮甜，香氣層次感爆棚。</p>
        </div>
        
        <div class="feature-card fade-in">
          <div class="icon">🔥</div>
          <h4>營火材料包</h4>
          <p>NT$ 800/組，包含木柴、火種、營火架，讓您在星空下享受營火晚會。</p>
        </div>
        
        <div class="feature-card fade-in">
          <div class="icon">🚲</div>
          <h4>舊山線鐵道自行車</h4>
          <p>加購優惠價 NT$ 300/人，體驗在鐵軌上俯瞰苗栗山川之美。</p>
        </div>
        
        <div class="feature-card fade-in">
          <div class="icon">🍖</div>
          <h4>烤肉食材組</h4>
          <p>NT$ 1,200/組（2-3人份），含肉品、海鮮、蔬菜、吐司、飲料，輕鬆享受烤肉樂趣。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <h3>🏕️ 不遠露營度假山莊</h3>
          <p>前身為退役礦場，歷經生態再造，如今成為占地 3.5 公頃的綠色天堂。</p>
          <div class="social-links">
            <a href="https://www.facebook.com/close2camp" target="_blank" title="Facebook">📘</a>
            <a href="https://www.instagram.com/" target="_blank" title="Instagram">📷</a>
            <a href="https://line.me/ti/p/@paq1032x" target="_blank" title="Line">💬</a>
            <a href="https://www.youtube.com/" target="_blank" title="YouTube">▶️</a>
          </div>
        </div>
        <div>
          <h3>快速連結</h3>
          <div class="footer-links">
            <a href="/about">關於我們</a>
            <a href="/campsite">營區介紹</a>
            <a href="/pricing">價格方案</a>
            <a href="/gallery">圖庫</a>
            <a href="/faq">常見問題</a>
          </div>
        </div>
        <div>
          <h3>服務項目</h3>
          <div class="footer-links">
            <a href="/booking">線上預訂</a>
            <a href="campsite.html#accommodation">住宿選擇</a>
            <a href="/contact">聯絡我們</a>
          </div>
        </div>
        <div>
          <h3>聯絡資訊</h3>
          <div class="footer-links">
            <a href="tel:+886918833021">📞 0918-833-021</a>
            <a href="tel:+88637870898">📞 037-870-898</a>
            <a href="mailto:info@close-2.com">✉️ info@close-2.com</a>
            <a href="https://maps.google.com/?q=苗栗縣三義鄉雙連潭9鄰199號" target="_blank">📍 苗栗縣三義鄉雙連潭9鄰199號</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© 2026 不遠露營度假山莊 · 苗栗縣民宿353號 · All Rights Reserved</p>
      </div>
    </div>
  </footer>

  <script src="/script.js" is:inline></script>
</body>
</html>