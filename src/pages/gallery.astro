---
import SEO from "../components/public/SEO.astro";
import "../styles/global.css";
import fs from 'fs';
import path from 'path';

// Fetch local room images
const roomsDir = path.join(process.cwd(), 'public', 'images', 'rooms');
let localRoomImages: { url: string; name: string }[] = [];
if (fs.existsSync(roomsDir)) {
  const roomFolders = fs.readdirSync(roomsDir).filter(f => fs.statSync(path.join(roomsDir, f)).isDirectory());
  roomFolders.forEach(folder => {
    const images = fs.readdirSync(path.join(roomsDir, folder)).filter(f => f.match(/\.(jpg|jpeg|png|webp)$/i));
    images.forEach(img => {
      localRoomImages.push({
        url: `/images/rooms/${folder}/${img}`,
        name: folder
      });
    });
  });
}

// Fetch local environment images dynamically
const envDir = path.join(process.cwd(), 'public', 'images', 'environment');
let localEnvImages: string[] = [];
if (fs.existsSync(envDir)) {
  localEnvImages = fs.readdirSync(envDir)
    .filter(f => f.match(/\.(jpg|jpeg|png|webp)$/i))
    .map(f => `/images/environment/${f}`)
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }));
}
