        <button class="btn btn-outline" onclick="filterGallery('scenery')">營區景色</button>
        <button class="btn btn-outline" onclick="filterGallery('room')">住宿</button>
        <button class="btn btn-outline" onclick="filterGallery('activity')">活動</button>
        <button class="btn btn-outline" onclick="filterGallery('food')">美食</button>
      </div>
      
      <div class="gallery-grid" id="galleryGrid">
        <!-- 營區景色 -->
        <div class="gallery-item fade-in" data-category="scenery">
          <img src="https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?w=600&q=80" alt="不遠山莊大草原">
          <div class="overlay">
            <h4>🌿 大草原</h4>
            <p>孩子們奔跑的綠色天堂</p>
          </div>
        </div>
        
        <div class="gallery-item fade-in" data-category="scenery">
          <img src="https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=600&q=80" alt="森林步道">
          <div class="overlay">
            <h4>🌲 森林步道</h4>
            <p>漫步在芬多精的懷抱中</p>
          </div>
        </div>
        
        <div class="gallery-item fade-in" data-category="scenery">
          <img src="https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=600&q=80" alt="營區樹林">
          <div class="overlay">
            <h4>🌳 綠意盎然</h4>
            <p>保留大量原生樹種</p>
          </div>
        </div>
        
        <div class="gallery-item fade-in" data-category="scenery">
          <img src="https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=600&q=80" alt="營區夜景">
