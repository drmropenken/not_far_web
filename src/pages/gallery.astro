---
import SEO from "../components/public/SEO.astro";
import "../styles/global.css";
import { supabase } from '../lib/supabase';

// Fetch items for dynamic gallery
const { data: items } = await supabase.from('nf_items').select('name, image_url, category');
const roomItems = items?.filter((i: any) => i.category === 'campsite' && i.image_url) || [];
---
<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <SEO 
    title="圖庫 - 不遠露營度假山莊" 
    description="不遠山莊精彩照片，欣賞營區美景、住宿與活動。" 
  />
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar" id="navbar">
    <div class="container">
      <a href="/" class="logo">
        <span>🏕️</span>
        <span>不遠山莊</span>
      </a>
      <div class="nav-links">
        <a href="/">首頁</a>
        <a href="/about">關於我們</a>
        <a href="/campsite">營區介紹</a>
        <a href="/gallery" class="active">圖庫</a>
        <a href="/faq">常見問題</a>
        <a href="/contact">聯絡我們</a>
        <a href="/my-orders">我的訂單</a>
        <a href="/app" class="btn btn-primary">立即預訂</a>
      </div>
      <div class="hamburger">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </nav>

  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <h1>精彩圖庫</h1>
      <p>一窺不遠山莊的美麗風貌</p>
    </div>
  </section>

  <!-- 圖庫分類 -->
  <section class="section">
    <div class="container">
      <div class="gallery-grid" id="galleryGrid">
        <!-- 環境 -->
        {[1, 2, 3, 4, 5, 6].map((num) => (
          <div class="gallery-item fade-in">
            <img src={`/images/environment/${num}.jpeg`} alt={`營區環境 ${num}`} loading="lazy" />
            <div class="overlay">
              <h4>🍃 營區環境</h4>
              <p>不遠山莊的周邊設施</p>
            </div>
          </div>
        ))}
        
        <!-- 營區景色 -->
        <div class="gallery-item fade-in">
          <img src="/images/cabin.jpg" alt="不遠山莊大草原">
          <div class="overlay">
            <h4>🌿 大草原</h4>
            <p>孩子們奔跑的綠色天堂</p>
          </div>
        </div>
        
        <div class="gallery-item fade-in">
          <img src="/images/tent.jpg" alt="森林步道">
          <div class="overlay">
            <h4>🌲 森林步道</h4>
            <p>漫步在芬多精的懷抱中</p>
          </div>
        </div>
        
        <div class="gallery-item fade-in">
          <img src="/images/pipe.jpg" alt="營區樹林">
          <div class="overlay">
            <h4>🌳 綠意盎然</h4>
            <p>保留大量原生樹種</p>
          </div>
        </div>
        
        <div class="gallery-item fade-in">
          <img src="https://static.wixstatic.com/media/2dfe85_895753b110d146808b7088c22a82b710~mv2.jpg" alt="營區夜景">
          <div class="overlay">
            <h4>🌙 夜景</h4>
            <p>夜晚燈火點綴的夢幻森林</p>
          </div>
        </div>
        
        <div class="gallery-item fade-in">
          <img src="https://static.wixstatic.com/media/2dfe85_b22d2373b6e94504915de48f929553d0~mv2.jpg" alt="星空">
          <div class="overlay">
            <h4>⭐ 星空</h4>
            <p>無光害的滿天星斗</p>
          </div>
        </div>
        
        <div class="gallery-item fade-in">
          <img src="https://static.wixstatic.com/media/7abe18_1c06bd5c1e1f46699a71c2aed060aae0~mv2.jpg" alt="蓮花池">
          <div class="overlay">
            <h4>🌺 蓮花池</h4>
            <p>靜謐的湖畔風光</p>
          </div>
        </div>
        
        <!-- 住宿 (動態渲染) -->
        {roomItems.map((item: any) => {
          const images = item.image_url.split(',').map((u: string) => u.trim()).filter(Boolean);
          const displayName = item.name.replace('住宿-', '').replace('上營區-', '').replace('下營區-', '');
          return images.map((imgUrl: string, idx: number) => (
            <div class="gallery-item fade-in">
              <img src={imgUrl} alt={`${displayName} - 圖片 ${idx + 1}`} loading="lazy" />
              <div class="overlay">
                <h4>⛺ {displayName}</h4>
                <p>不遠山莊精選營地與住宿</p>
              </div>
            </div>
          ));
        })}
        
        <!-- 活動 -->
        <div class="gallery-item fade-in" data-category="activity">
          <img src="/images/tent.jpg" alt="跳跳床">
          <div class="overlay">
            <h4>🤸 跳跳床</h4>
            <p>大人小孩都玩瘋了</p>
          </div>
        </div>
        
        <div class="gallery-item fade-in" data-category="activity">
          <img src="/images/pipe.jpg" alt="兒童遊戲區">
          <div class="overlay">
            <h4>🎠 兒童遊戲區</h4>
            <p>沙坑、鞦韆、溜滑梯</p>
          </div>
        </div>
        
        <div class="gallery-item fade-in" data-category="activity">
          <img src="https://static.wixstatic.com/media/2dfe85_895753b110d146808b7088c22a82b710~mv2.jpg" alt="營火晚會">
          <div class="overlay">
            <h4>🔥 營火晚會</h4>
            <p>星空下的溫暖時光</p>
          </div>
        </div>
        
        <div class="gallery-item fade-in" data-category="activity">
          <img src="https://static.wixstatic.com/media/2dfe85_b22d2373b6e94504915de48f929553d0~mv2.jpg" alt="賞螢">
          <div class="overlay">
            <h4>✨ 賞螢</h4>
            <p>夏季限定的螢火蟲盛宴</p>
          </div>
        </div>
        
        <div class="gallery-item fade-in" data-category="activity">
          <img src="https://static.wixstatic.com/media/7abe18_1c06bd5c1e1f46699a71c2aed060aae0~mv2.jpg" alt="賞櫻">
          <div class="overlay">
            <h4>🌸 賞櫻</h4>
            <p>春季櫻花盛開美景</p>
          </div>
        </div>
        
        <div class="gallery-item fade-in" data-category="activity">
          <img src="https://static.wixstatic.com/media/7abe18_49ca372653b2465d8690c88299cce670~mv2.jpg" alt="健行">
          <div class="overlay">
            <h4>🥾 健行步道</h4>
            <p>探索自然之美</p>
          </div>
        </div>
        
        <!-- 美食 -->
        <div class="gallery-item fade-in" data-category="food">
          <img src="https://static.wixstatic.com/media/2dfe85_275286058a214928b4073c0f327dcf92~mv2.jpg" alt="烤肉">
          <div class="overlay">
            <h4>🍖 豪華烤肉</h4>
            <p>生食級干貝、精選肉品</p>
          </div>
        </div>
        
        <div class="gallery-item fade-in" data-category="food">
          <img src="https://static.wixstatic.com/media/7abe18_415a7be96fe3459f858ee4babfc6b6c6~mv2.jpg" alt="火鍋">
          <div class="overlay">
            <h4>🍲 暖心火鍋</h4>
            <p>濃白雞湯與麻辣湯底</p>
          </div>
        </div>
        
        <div class="gallery-item fade-in" data-category="food">
          <img src="https://static.wixstatic.com/media/7abe18_dd36d61242444e0c8eb5e2fa8c64d0a8~mv2.jpg" alt="鹿角咖啡">
          <div class="overlay">
            <h4>☕ 鹿角咖啡</h4>
            <p>森林系巴士咖啡廳</p>
          </div>
        </div>
        
        <div class="gallery-item fade-in" data-category="food">
          <img src="/images/hero.jpg" alt="早餐">
          <div class="overlay">
            <h4>🥐 自助早餐</h4>
            <p>豐盛的自助吧早餐</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <h3>🏕️ 不遠露營度假山莊</h3>
          <p>前身為退役礦場，歷經生態再造，如今成為占地 3.5 公頃的綠色天堂。</p>
          <div class="social-links">
            <a href="https://www.facebook.com/close2camp" target="_blank" title="Facebook">📘</a>
            <a href="https://www.instagram.com/" target="_blank" title="Instagram">📷</a>
            <a href="https://line.me/ti/p/@paq1032x" target="_blank" title="Line">💬</a>
            <a href="https://www.youtube.com/" target="_blank" title="YouTube">▶️</a>
          </div>
        </div>
        <div>
          <h3>快速連結</h3>
          <div class="footer-links">
            <a href="/about">關於我們</a>
            <a href="/campsite">營區介紹</a>
            <a href="/gallery">圖庫</a>
            <a href="/faq">常見問題</a>
          </div>
        </div>
        <div>
          <h3>服務項目</h3>
          <div class="footer-links">
            <a href="/app">線上預訂</a>
            <a href="/campsite#accommodation">住宿選擇</a>
            <a href="/contact">聯絡我們</a>
          </div>
        </div>
        <div>
          <h3>聯絡資訊</h3>
          <div class="footer-links">
            <a href="tel:+886911233810"><span class="shrink-0">📞</span> <span>0911-233-810</span></a>
            <a href="tel:+88637870898"><span class="shrink-0">📞</span> <span>037-870-898</span></a>
            <a href="mailto:close2.tw@gmail.com"><span class="shrink-0">✉️</span> <span>close2.tw@gmail.com</span></a>
            <a href="https://maps.google.com/?q=苗栗縣三義鄉雙連潭9鄰199號" target="_blank"><span class="shrink-0">📍</span> <span>苗栗縣三義鄉雙連潭9鄰199號</span></a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© 2026 不遠露營度假山莊 · 苗栗縣民宿353號 · All Rights Reserved</p>
      </div>
    </div>
  </footer>

  <script src="/script.js" is:inline></script>
  <script is:inline>
    // Reveal animation for all images immediately without filtering
    document.addEventListener('DOMContentLoaded', () => {
      const items = document.querySelectorAll('.gallery-item');
      items.forEach((item, index) => {
        setTimeout(() => item.classList.add('visible'), index * 30);
      });
    });
  </script>
</body>
</html>