---
import "../../styles/tailwind.css";
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>營主登入 | 訂位管理系統</title>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center">
  
  <div class="max-w-md w-full bg-white rounded-2xl shadow-xl overflow-hidden">
    <div class="bg-green-700 py-6 px-8 text-center">
      <h1 class="text-2xl font-bold text-white tracking-wide">🏕️ 不遠山莊管理系統</h1>
    </div>
    
    <div class="p-8 text-center">
      <p class="text-gray-600 mb-8">請使用已授權的管理員 Google 帳號登入</p>
      
      <button id="google-login-btn" class="w-full bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-bold py-3 px-4 rounded-lg transition-colors flex justify-center items-center gap-3 shadow-sm">
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        <span>以 Google 帳號登入</span>
      </button>

      <div id="error-msg" class="text-red-500 text-sm hidden bg-red-50 p-3 rounded-lg border border-red-100 mt-6"></div>
    </div>
  </div>

  <script>
    import { supabase } from "@/lib/supabase";

    // 檢查是否已登入
    supabase.auth.getSession().then(({ data: { session } }) => {
      if (session) {
        window.location.href = "/admin";
      }
    });

    const googleBtn = document.getElementById("google-login-btn");
    const errorMsg = document.getElementById("error-msg");

    if (googleBtn) {
      googleBtn.addEventListener("click", async () => {
        googleBtn.innerHTML = `<svg class="animate-spin h-5 w-5 text-gray-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> <span>轉跳中...</span>`;
        if (errorMsg) errorMsg.classList.add("hidden");

        const { error } = await supabase.auth.signInWithOAuth({
          provider: 'google',
          options: {
            redirectTo: `${window.location.origin}/admin`,
            queryParams: {
              prompt: 'select_account'
            }
          }
        });

        if (error && errorMsg) {
          errorMsg.textContent = "登入發生錯誤，請稍後再試。";
          errorMsg.classList.remove("hidden");
          googleBtn.innerHTML = `<span>以 Google 帳號登入</span>`;
        }
      });
    }

    // 檢查 URL 中是否有錯誤訊息 (例如權限不足被踢回來)
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('error') === 'unauthorized' && errorMsg) {
      errorMsg.textContent = "存取被拒：您的帳號沒有管理員權限！";
      errorMsg.classList.remove("hidden");
    }
  </script>
</body>
</html>
