---
import "../../styles/global.css";
import { supabase } from "../../lib/supabase";

// 服務端渲染：取得所有營區列表
const { data: campgrounds } = await supabase
  .from('nf_campgrounds')
  .select('id, name, slug, description')
  .order('name', { ascending: true });
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>選擇營區 | 營主管理系統</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 50%, #fefce8 100%);
      font-family: 'Noto Sans TC', sans-serif;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-center p-6">
  
  <!-- 頂部條 -->
  <div class="fixed top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-emerald-400 via-emerald-500 to-emerald-600"></div>

  <div class="w-full max-w-2xl">
    <!-- Logo 與標題區 -->
    <div class="text-center mb-12">
      <div class="w-20 h-20 mx-auto mb-6 rounded-3xl bg-white shadow-lg shadow-emerald-200/50 flex items-center justify-center text-4xl border border-emerald-100">
        🏕️
      </div>
      <h1 class="text-3xl font-black text-stone-800 tracking-wider">選擇營區</h1>
      <p class="text-stone-500 font-medium mt-2">請選擇您要進入管理的營區</p>
    </div>

    <!-- 營區列表 -->
    <div class="space-y-4" id="campground-list">
      {(campgrounds || []).map(camp => (
        <div
          class="bg-white rounded-2xl border border-stone-200 hover:border-emerald-400 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 cursor-pointer group overflow-hidden"
          data-camp-id={camp.id}
          data-camp-name={camp.name}
        >
          <div class="p-5 flex items-center gap-5">
            <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-emerald-50 to-emerald-100 flex items-center justify-center text-2xl shrink-0 border border-emerald-200/50 group-hover:scale-110 group-hover:rotate-3 transition-all duration-200">
              ⛺️
            </div>
            <div class="flex-1 min-w-0">
              <h2 class="text-xl font-black text-stone-800 group-hover:text-emerald-600 transition-colors">{camp.name}</h2>
              {camp.description && (
                <p class="text-sm text-stone-500 mt-1 leading-relaxed line-clamp-2">{camp.description}</p>
              )}
            </div>
            <div class="text-emerald-300 group-hover:text-emerald-500 transition-colors shrink-0">
              <svg class="w-6 h-6 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </div>
          </div>
        </div>
      ))}
    </div>

    {(!campgrounds || campgrounds.length === 0) && (
      <div class="text-center py-20 bg-white/80 backdrop-blur-sm rounded-2xl border-2 border-dashed border-stone-300">
        <div class="text-6xl mb-4">📭</div>
        <p class="text-stone-500 font-bold text-lg">目前沒有可管理的營區</p>
        <p class="text-stone-400 text-sm mt-1">請聯繫系統管理員開通權限</p>
      </div>
    )}

    <!-- 底部 -->
    <div class="text-center mt-10">
      <button id="logout-btn" class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-stone-400 hover:text-rose-500 bg-white/60 hover:bg-white border border-stone-200 hover:border-rose-200 rounded-xl transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
        登出
      </button>
    </div>
  </div>

  <script>
    import { supabase } from "../../lib/supabase";

    (async () => {
      // 🔒 檢查是否已登入
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/admin/login';
        return;
      }

      // 🔒 檢查是否為管理員
      const { data: adminRecords } = await supabase
        .from('nf_admins')
        .select('role, camp_id')
        .eq('email', session.user.email.toLowerCase());

      if (!adminRecords || adminRecords.length === 0) {
        await supabase.auth.signOut();
        window.location.href = '/admin/login?error=unauthorized';
        return;
      }

      // 收集可存取的 camp_id
      const accessibleIds = adminRecords.map(r => r.camp_id).filter(Boolean);
      const hasNullAccess = adminRecords.some(r => r.camp_id === null);

      // 存入 localStorage，讓 AdminLayout 使用
      localStorage.setItem('admin_role', adminRecords[0].role);
      localStorage.setItem('admin_email', session.user.email);
      localStorage.setItem('admin_camp_ids', JSON.stringify(accessibleIds));
      localStorage.setItem('admin_has_null_access', hasNullAccess ? 'true' : 'false');

      // 清除舊的選擇
      localStorage.removeItem('camp_id');
      localStorage.removeItem('camp_name');

      // 篩選顯示：沒有 null access 的人，只看到自己有權限的營區
      if (!hasNullAccess) {
        document.querySelectorAll('[data-camp-id]').forEach(el => {
          if (!accessibleIds.includes(el.dataset.campId)) {
            el.style.display = 'none';
          }
        });

        // 如果全部都被藏起來 → 顯示無權限訊息
        const visible = document.querySelector('[data-camp-id]:not([style*="display: none"])');
        if (!visible) {
          document.getElementById('no-access-msg')?.classList.remove('hidden');
        }
      }

      // 綁定營區卡片點擊
      document.getElementById('campground-list')?.addEventListener('click', (e) => {
        const card = e.target.closest('[data-camp-id]');
        if (!card) return;

        localStorage.setItem('camp_id', card.dataset.campId);
        localStorage.setItem('camp_name', card.dataset.campName);
        window.location.href = '/admin';
      });

      // 綁定登出
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await supabase.auth.signOut();
        window.location.href = '/admin/login';
      });
    })();
  </script>
</body>
</html>