---
import "../../styles/global.css";
import { supabase } from "../../lib/supabase";

// 服務端渲染：取得所有營區列表
const { data: campgrounds } = await supabase
  .from('nf_campgrounds')
  .select('id, name, slug, description')
  .order('name', { ascending: true });
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>選擇營區 | 營主管理系統</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
    }
    :root {
      --admin-primary: #2d6a4f;
      --admin-primary-dark: #1b4332;
      --admin-primary-soft: #e8f3ed;
      --admin-gold: #d4a373;
      --admin-bg: #f6f7f2;
      --admin-text: #24312b;
      --admin-muted: #68736c;
      --admin-border: rgba(45, 106, 79, 0.14);
      --admin-shadow: 0 20px 50px rgba(27, 67, 50, 0.12);
    }

    body.campground-picker {
      min-height: 100vh;
      margin: 0;
      background:
        radial-gradient(circle at 18% 12%, rgba(212, 163, 115, 0.22), transparent 28%),
        radial-gradient(circle at 82% 20%, rgba(64, 145, 108, 0.16), transparent 32%),
        linear-gradient(135deg, #f8faf5 0%, #edf6f0 52%, #f7f1e5 100%);
      color: var(--admin-text);
      font-family: 'Noto Sans TC', sans-serif;
    }

    .picker-shell {
      display: grid;
      min-height: 100vh;
      place-items: center;
      padding: 32px 20px;
    }

    .picker-panel {
      width: min(100%, 760px);
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.72);
      border-radius: 28px;
      background: rgba(255, 255, 255, 0.78);
      box-shadow: var(--admin-shadow);
      backdrop-filter: blur(18px);
    }

    .picker-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 34px 36px 28px;
      border-bottom: 1px solid var(--admin-border);
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.8), rgba(232, 243, 237, 0.86));
    }

    .brand-mark {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 18px;
      color: var(--admin-primary-dark);
      font-size: 0.92rem;
      font-weight: 800;
      letter-spacing: 0.16em;
    }

    .brand-icon,
    .camp-icon,
    .empty-icon {
      display: grid;
      place-items: center;
      flex: 0 0 auto;
    }

    .brand-icon {
      width: 42px;
      height: 42px;
      border-radius: 14px;
      background: var(--admin-primary-dark);
      color: #fff;
      font-size: 1.32rem;
      box-shadow: 0 10px 24px rgba(27, 67, 50, 0.2);
    }

    .picker-title {
      margin: 0;
      color: var(--admin-primary-dark);
      font-size: clamp(2rem, 6vw, 3.2rem);
      font-weight: 900;
      letter-spacing: 0.04em;
      line-height: 1.08;
    }

    .picker-subtitle {
      max-width: 420px;
      margin: 14px 0 0;
      color: var(--admin-muted);
      font-size: 1.02rem;
      font-weight: 500;
      line-height: 1.7;
    }

    .header-note {
      min-width: 130px;
      border-left: 3px solid var(--admin-gold);
      padding-left: 16px;
      color: var(--admin-muted);
      font-size: 0.9rem;
      line-height: 1.55;
    }

    .header-note strong {
      display: block;
      color: var(--admin-primary-dark);
      font-size: 1.02rem;
    }

    .picker-content {
      padding: 28px 36px 34px;
    }

    .campground-list {
      display: grid;
      gap: 14px;
    }

    .camp-card {
      width: 100%;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 18px;
      padding: 18px;
      border: 1px solid rgba(45, 106, 79, 0.16);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.9);
      color: inherit;
      text-align: left;
      cursor: pointer;
      box-shadow: 0 8px 22px rgba(36, 49, 43, 0.05);
      transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease, background 180ms ease;
    }

    .camp-card:hover,
    .camp-card:focus-visible {
      transform: translateY(-2px);
      border-color: rgba(45, 106, 79, 0.42);
      background: #fff;
      box-shadow: 0 16px 34px rgba(27, 67, 50, 0.13);
      outline: none;
    }

    .camp-icon {
      width: 58px;
      height: 58px;
      border-radius: 16px;
      background: linear-gradient(135deg, #e9f5ee, #fff7e8);
      color: var(--admin-primary-dark);
      font-size: 1.55rem;
      border: 1px solid rgba(45, 106, 79, 0.12);
    }

    .camp-name {
      margin: 0;
      color: #202820;
      font-size: 1.28rem;
      font-weight: 900;
      letter-spacing: 0.02em;
      line-height: 1.25;
    }

    .camp-description {
      display: block;
      margin: 7px 0 0;
      color: var(--admin-muted);
      font-size: 0.95rem;
      font-weight: 500;
      line-height: 1.6;
    }

    .camp-arrow {
      display: grid;
      place-items: center;
      width: 38px;
      height: 38px;
      border-radius: 999px;
      background: var(--admin-primary-soft);
      color: var(--admin-primary);
      transition: transform 180ms ease, background 180ms ease, color 180ms ease;
    }

    .camp-card:hover .camp-arrow,
    .camp-card:focus-visible .camp-arrow {
      transform: translateX(3px);
      background: var(--admin-primary);
      color: #fff;
    }

    .empty-state {
      padding: 34px 18px;
      border: 1px dashed rgba(45, 106, 79, 0.28);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.58);
      text-align: center;
    }

    .empty-state.hidden {
      display: none;
    }

    .empty-icon {
      width: 58px;
      height: 58px;
      margin: 0 auto 14px;
      border-radius: 18px;
      background: var(--admin-primary-soft);
      font-size: 1.7rem;
    }

    .empty-title {
      margin: 0;
      color: var(--admin-primary-dark);
      font-size: 1.12rem;
      font-weight: 800;
    }

    .empty-copy {
      margin: 6px 0 0;
      color: var(--admin-muted);
      font-size: 0.92rem;
    }

    .picker-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-top: 24px;
      color: var(--admin-muted);
      font-size: 0.86rem;
    }

    .logout-button {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid rgba(104, 115, 108, 0.18);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.72);
      color: #6f766f;
      padding: 10px 16px;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
      transition: color 180ms ease, border-color 180ms ease, background 180ms ease, transform 180ms ease;
    }

    .logout-button:hover,
    .logout-button:focus-visible {
      transform: translateY(-1px);
      border-color: rgba(190, 18, 60, 0.2);
      background: #fff;
      color: #be123c;
      outline: none;
    }

    @media (max-width: 640px) {
      .picker-shell {
        align-items: stretch;
        padding: 16px;
      }

      .picker-panel {
        border-radius: 22px;
      }

      .picker-header,
      .picker-content {
        padding-left: 20px;
        padding-right: 20px;
      }

      .picker-header {
        display: block;
        padding-top: 28px;
      }

      .header-note {
        margin-top: 22px;
        border-left: 0;
        border-top: 3px solid var(--admin-gold);
        padding: 14px 0 0;
      }

      .camp-card {
        grid-template-columns: auto 1fr;
        gap: 14px;
        padding: 16px;
      }

      .camp-arrow {
        grid-column: 2;
        justify-self: end;
        margin-top: -4px;
      }

      .picker-footer {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>
</head>
<body class="campground-picker">
  <main class="picker-shell">
    <section class="picker-panel" aria-labelledby="picker-title">
      <header class="picker-header">
        <div>
          <div class="brand-mark">
            <span class="brand-icon">🏕️</span>
            <span>SunnyCampTW 管理系統</span>
          </div>
          <h1 class="picker-title" id="picker-title">選擇營區</h1>
          <p class="picker-subtitle">請選擇要進入管理的營區。選好後會帶入訂單、庫存與商品後台。</p>
        </div>
        <p class="header-note">
          <strong>{campgrounds?.length || 0} 個營區</strong>
          可管理的營區會依照帳號權限顯示
        </p>
      </header>

      <div class="picker-content">
        <div class="campground-list" id="campground-list">
      {(campgrounds || []).map(camp => (
        <button
          type="button"
          class="camp-card"
          data-camp-id={camp.id}
          data-camp-name={camp.name}
        >
          <span class="camp-icon">⛺</span>
          <span>
            <span class="camp-name">{camp.name}</span>
              {camp.description && (
              <span class="camp-description">{camp.description}</span>
              )}
          </span>
          <span class="camp-arrow" aria-hidden="true">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M9 5l7 7-7 7"></path></svg>
          </span>
        </button>
      ))}
        </div>

        <div class={`empty-state ${campgrounds && campgrounds.length > 0 ? 'hidden' : ''}`} id="no-access-msg">
          <div class="empty-icon">📭</div>
          <p class="empty-title">目前沒有可管理的營區</p>
          <p class="empty-copy">請聯繫系統管理員開通權限。</p>
        </div>

        <footer class="picker-footer">
          <span>管理後台會依照選定營區載入資料。</span>
          <button id="logout-btn" class="logout-button" type="button">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
            登出
          </button>
        </footer>
      </div>
    </section>
  </main>

  <script>
    import { supabase } from "../../lib/supabase";

    (async () => {
      // 🔒 檢查是否已登入
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/admin/login';
        return;
      }

      // 🔒 檢查是否為管理員
      const { data: adminRecords } = await supabase
        .from('nf_admins')
        .select('role, camp_id')
        .eq('email', session.user.email.toLowerCase());

      if (!adminRecords || adminRecords.length === 0) {
        await supabase.auth.signOut();
        window.location.href = '/admin/login?error=unauthorized';
        return;
      }

      // 收集可存取的 camp_id
      const accessibleIds = adminRecords.map(r => r.camp_id).filter(Boolean);
      const hasNullAccess = adminRecords.some(r => r.camp_id === null);

      // 存入 localStorage，讓 AdminLayout 使用
      localStorage.setItem('admin_role', adminRecords[0].role);
      localStorage.setItem('admin_email', session.user.email);
      localStorage.setItem('admin_camp_ids', JSON.stringify(accessibleIds));
      localStorage.setItem('admin_has_null_access', hasNullAccess ? 'true' : 'false');

      // 清除舊的選擇
      localStorage.removeItem('camp_id');
      localStorage.removeItem('camp_name');

      // 篩選顯示：沒有 null access 的人，只看到自己有權限的營區
      if (!hasNullAccess) {
        document.querySelectorAll('[data-camp-id]').forEach(el => {
          if (!accessibleIds.includes(el.dataset.campId)) {
            el.style.display = 'none';
          }
        });

        // 如果全部都被藏起來 → 顯示無權限訊息
        const visible = document.querySelector('[data-camp-id]:not([style*="display: none"])');
        if (!visible) {
          document.getElementById('no-access-msg')?.classList.remove('hidden');
        }
      }

      // 綁定營區卡片點擊
      document.getElementById('campground-list')?.addEventListener('click', (e) => {
        const card = e.target.closest('[data-camp-id]');
        if (!card) return;

        localStorage.setItem('camp_id', card.dataset.campId);
        localStorage.setItem('camp_name', card.dataset.campName);
        window.location.href = '/admin';
      });

      // 綁定登出
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await supabase.auth.signOut();
        window.location.href = '/admin/login';
      });
    })();
  </script>
</body>
</html>
