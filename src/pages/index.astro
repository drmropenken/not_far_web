---
import "../styles/global.css";
import SEO from "../components/public/SEO.astro";
import ImageCarousel from '../components/public/ImageCarousel';
import { supabase } from '../lib/supabase';

// Fetch items for dynamic images
const { data: items } = await supabase.from('nf_items').select('name, image_url');

const getImageUrls = (nameStr: string) => {
  const coreNameMatch = nameStr.match(/(大巴|包棟|帳篷組|石茅屋|水管屋|欖仁樹|草原|湖岸)/);
  const coreName = coreNameMatch ? coreNameMatch[0] : nameStr;
  const item = items?.find(i => i.name.includes(coreName));
  return item?.image_url ? item.image_url.split(',').map((u: string) => u.trim()).filter(Boolean) : [];
};
