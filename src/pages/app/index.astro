---

import AppLayout from "../../layouts/AppLayout.astro";
import BookingFlow from "../../components/public/BookingFlow";
import { supabase } from "../../lib/supabase";

// 從 URL 讀取 camp_id，若無則重新導向到帶有不遠山莊 camp_id 的網址
let campId = Astro.url.searchParams.get('camp_id') || '';

if (!campId) {
  const { data: defaultCamp } = await supabase
    .from('nf_campgrounds')
    .select('id')
    .eq('slug', 'not-far')
    .single();
  if (defaultCamp) {
    return Astro.redirect(`/app?camp_id=${defaultCamp.id}`);
  }
}
---

<AppLayout title="線上預訂 - SunnyCampTW">
  <BookingFlow client:only="react" campId={campId} />
</AppLayout>
