---

import AppLayout from "../../layouts/AppLayout.astro";
import BookingFlow from "../../components/public/BookingFlow";
import { supabase } from "../../lib/supabase";

// 從 URL 讀取 camp_id，若無則檢查 liff.state，最後才使用預設值
let campId = Astro.url.searchParams.get('camp_id') || '';

if (!campId) {
  const liffState = Astro.url.searchParams.get('liff.state');
  if (liffState) {
    const stateParams = new URLSearchParams(liffState.replace(/^[^?]*\?/, ''));
    if (stateParams.get('camp_id')) {
      campId = stateParams.get('camp_id') || '';
    }
  }
}

if (!campId) {
  const { data: defaultCamp } = await supabase
    .from('nf_campgrounds')
    .select('id')
    .eq('slug', 'not-far')
    .single();
  if (defaultCamp) {
    campId = defaultCamp.id;
    const currentParams = new URLSearchParams(Astro.url.searchParams);
    currentParams.set('camp_id', defaultCamp.id);
    return Astro.redirect(`${Astro.url.pathname}?${currentParams.toString()}`);
  }
}

// 取得營區資料
let campName = 'SunnyCampTW';
let campDescription = '';
let campOfficialUrl = '';
if (campId) {
  const { data: camp } = await supabase
    .from('nf_campgrounds')
    .select('name, description, official_url')
    .eq('id', campId)
    .single();
  if (camp) {
    campName = camp.name;
    campDescription = camp.description || `${campName} 線上預訂系統`;
    campOfficialUrl = camp.official_url || '';
  }
}
---

<AppLayout title={`線上預訂 - ${campName}`} description={campDescription}>
  <BookingFlow client:only="react" campId={campId} campName={campName} officialUrl={campOfficialUrl} />
</AppLayout>
