---
import SEO from "../components/public/SEO.astro";
import { supabase } from '../lib/supabase';
import ImageCarousel from '../components/public/ImageCarousel';
import "../styles/global.css";
import roomImagesMap from '../lib/roomImagesMap.json';

// Fetch items for dynamic images and to append missing campsites
const { data: items } = await supabase.from('nf_items').select('name, description, image_url, category').eq('is_active', true);

const getImageUrls = (searchName: string) => {
  const item = items?.find(i => i.name.includes(searchName));
  const dbImages = item?.image_url ? item.image_url.split(',').map((u: string) => u.trim()).filter(Boolean) : [];
  if (dbImages.length > 0) {
    return dbImages;
  }
  const key = Object.keys(roomImagesMap).find(k => k.includes(searchName));
  if (key && (roomImagesMap as any)[key].length > 0) {
    return (roomImagesMap as any)[key];
  }
  return [];
};

// Filter out campsites that are already hardcoded
const hardcodedKeywords = ['豪華野奢帳篷', '石茅屋', '水管屋', '欖仁樹', '草原一區', '湖岸一區', '大巴', '包棟'];
const missingCampsites = items?.filter(item => {
  if (item.category !== 'campsite') return false;
  const isHardcoded = hardcodedKeywords.some(kw => item.name.includes(kw));
  const hasLocalImages = (roomImagesMap as any)[item.name]?.length > 0;
  return !isHardcoded && (item.image_url || item.description || hasLocalImages);
}) || [];
---
<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <SEO 
    title="營區介紹與住宿選擇｜不遠露營度假山莊｜苗栗露營推薦" 
    description="不遠山莊營區佔地約3.5公頃，提供草地營位、小木屋、水管屋、哈比屋、合掌村石茅屋等多元住宿，設施完善。" 
  />
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar" id="navbar">
    <div class="container">
      <a href="/" class="logo">
        <span>🏕️</span>
        <span>不遠山莊</span>
      </a>
      <div class="nav-links">
        <a href="/">首頁</a>
