        <a href="/campsite" class="active">營區介紹</a>
        <a href="/gallery">圖庫</a>
        <a href="/faq">常見問題</a>
        <a href="/contact">聯絡我們</a>
        <a href="/my-orders">我的訂單</a>
        <a href="/app" class="btn btn-primary">立即預訂</a>
      </div>
      <div class="hamburger">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </nav>

  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <h1>營區介紹</h1>
      <p>占地 3.5 公頃的綠色天堂，探索不遠山莊的每一個角落</p>
    </div>
  </section>

  <!-- 營區概覽 -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">營區概覽</h2>
      <p class="section-subtitle">不遠山莊分為上營區、景觀區、下營區三大區域，每個區域各有特色</p>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
        <div class="glass-card fade-in" style="padding: 28px;">
          <div style="font-size: 2.5rem; margin-bottom: 12px;">🌲</div>
          <h3 style="color: var(--primary-dark); margin-bottom: 8px;">上營區</h3>
          <p style="color: var(--text-light); line-height: 1.8;">最受歡迎的區域！樹多且遮蔭率高，有大草原供孩子奔跑。包含木棧板區、欖仁樹區、草原區、湖岸區。設有兒童遊憩空間（沙坑、鞦韆、彈跳床），衛浴較新穎寬敞。</p>
        </div>
        
        <div class="glass-card fade-in" style="padding: 28px;">
          <div style="font-size: 2.5rem; margin-bottom: 12px;">🏔️</div>
          <h3 style="color: var(--primary-dark); margin-bottom: 8px;">景觀區</h3>
          <p style="color: var(--text-light); line-height: 1.8;">位於上營區上方，四周樹多，可遠眺山景。包含景觀一區、景觀二區、水管屋、景觀碎石區。靠近營區吊橋與賞櫻位置，適合喜歡寧靜的露友。</p>
        </div>
        
        <div class="glass-card fade-in" style="padding: 28px;">
          <div style="font-size: 2.5rem; margin-bottom: 12px;">🌊</div>
          <h3 style="color: var(--primary-dark); margin-bottom: 8px;">下營區</h3>
          <p style="color: var(--text-light); line-height: 1.8;">營區最下方，進門最先抵達。設有晴雨教室、雅房大通鋪、草地E/F區。夏季放置超大型充氣滑水道泳池，適合喜歡玩水的家庭。雨棚區也在這裡。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 住宿類型 -->
  <section class="section" style="background: #f0f7f4;" id="accommodation">
    <div class="container">
      <h2 class="section-title">住宿選擇</h2>
      <p class="section-subtitle">從傳統露營到豪華住宿，滿足各種需求</p>
      
      <div class="accommodation-grid">
        {items?.find(i => i.name.includes('豪華野奢帳篷')) && (
          <div class="accommodation-card fade-in flex flex-col h-full">
            <div class="w-full h-48 md:h-[250px] overflow-hidden rounded-t-xl">
              {getImageUrls('豪華野奢帳篷組').length > 0 ? (
                <ImageCarousel client:visible images={getImageUrls('豪華野奢帳篷組')} alt="豪華野奢帳篷組" className="w-full h-full" />
              ) : (
                <img src="/images/rooms/glamping.jpeg" alt="豪華野奢帳篷組" style="width: 100%; height: 100%; object-fit: cover;">
              )}
            </div>
            <div class="card-body flex-1">
              <h3>⛺ 豪華野奢帳篷組</h3>
              <p>極致奢華的免裝備露營！含雙人床、電扇與專屬客廳帳，提供一泊三食（含燒烤或火鍋晚餐），享受尊榮服務。</p>
              <div class="tags">
                <span class="tag">可住 4-6 人</span>
                <span class="tag">一泊三食</span>
                <span class="tag">免裝備</span>
