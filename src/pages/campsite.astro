              {getImageUrls('四人石茅屋').length > 0 ? (
                <ImageCarousel client:visible images={getImageUrls('四人石茅屋')} alt="四人石茅屋" className="w-full h-full" />
              ) : (
                <img src="/images/rooms/stone-hut.jpeg" alt="四人石茅屋" style="width: 100%; height: 100%; object-fit: cover;">
              )}
            </div>
            <div class="card-body flex-1">
              <h3>🛖 四人石茅屋</h3>
              <p>一秒踏進日本合掌村！外型超可愛的三角茅屋，內部空間寬敞，適合家庭同住，並設有獨立衛浴與冷氣。</p>
              <div class="tags">
                <span class="tag">可住 4 人</span>
                <span class="tag">獨立衛浴</span>
                <span class="tag">含早餐</span>
              </div>
            </div>
          </div>
        )}
        
        {items?.find(i => i.name.includes('四人水管屋雅房')) && (
