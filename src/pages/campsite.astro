              ) : (
                <img src="/images/rooms/pipe-house.jpeg" alt="四人水管屋雅房" style="width: 100%; height: 100%; object-fit: cover;">
              )}
            </div>
            <div class="card-body flex-1">
              <h3>🛖 四人水管屋雅房</h3>
              <p>造型獨特的水管屋，像極了可愛的汽水罐！備有冷氣與雙人床，車子可直接停在一旁，方便又特別。</p>
              <div class="tags">
                <span class="tag">可住 4 人</span>
                <span class="tag">冷氣</span>
                <span class="tag">含早餐</span>
              </div>
            </div>
          </div>
        )}

        {items?.find(i => i.name.includes('欖仁樹區')) && (
          <div class="accommodation-card fade-in flex flex-col h-full">
            <div class="w-full h-48 md:h-[250px] overflow-hidden rounded-t-xl">
              {getImageUrls('欖仁樹區').length > 0 ? (
                <ImageCarousel client:visible images={getImageUrls('欖仁樹區')} alt="欖仁樹區 (一至二帳包區)" className="w-full h-full" />
              ) : (
                <img src="/images/rooms/tree-zone.jpeg" alt="欖仁樹區 (一至二帳包區)" style="width: 100%; height: 100%; object-fit: cover;">
              )}
            </div>
            <div class="card-body flex-1">
              <h3>🌳 欖仁樹區 (一至二帳包區)</h3>
              <p>樹蔭環繞的舒適營位，適合三五好友小包區。提供獨立的搭帳空間，鄰近公共衛浴，享受靜謐的露營時光。</p>
              <div class="tags">
                <span class="tag">包區營位</span>
                <span class="tag">可住 4-8 人</span>
                <span class="tag">可攜寵物</span>
              </div>
            </div>
          </div>
        )}

        {items?.find(i => i.name.includes('草原一區')) && (
          <div class="accommodation-card fade-in flex flex-col h-full">
            <div class="w-full h-48 md:h-[250px] overflow-hidden rounded-t-xl">
              {getImageUrls('草原一區').length > 0 ? (
                <ImageCarousel client:visible images={getImageUrls('草原一區')} alt="草原區" className="w-full h-full" />
              ) : (
                <img src="/images/rooms/grass-zone.jpeg" alt="草原區" style="width: 100%; height: 100%; object-fit: cover;">
              )}
            </div>
            <div class="card-body flex-1">
              <h3>🏕️ 草原區 (四至五帳包區)</h3>
              <p>遼闊的大草皮，適合多個家庭聯合包區！孩子們可以盡情奔跑玩耍，享受無拘無束的大自然。</p>
              <div class="tags">
                <span class="tag">大草皮包區</span>
                <span class="tag">可住 16-20 人</span>
                <span class="tag">可攜寵物</span>
              </div>
            </div>
          </div>
        )}

        {items?.find(i => i.name.includes('湖岸一區')) && (
          <div class="accommodation-card fade-in flex flex-col h-full">
            <div class="w-full h-48 md:h-[250px] overflow-hidden rounded-t-xl">
              {getImageUrls('湖岸一區').length > 0 ? (
                <ImageCarousel client:visible images={getImageUrls('湖岸一區')} alt="湖岸一區 (六帳包區)" className="w-full h-full" />
              ) : (
                <img src="/images/rooms/lake-zone.jpeg" alt="湖岸一區 (六帳包區)" style="width: 100%; height: 100%; object-fit: cover;">
              )}
            </div>
            <div class="card-body flex-1">
              <h3>🏞️ 湖岸一區 (六帳包區)</h3>
              <p>絕佳的湖畔景觀，適合大型團體包區。面積廣達 50M*9M，給您最寬敞、最舒適的水岸露營體驗。</p>
              <div class="tags">
                <span class="tag">湖畔包區</span>
                <span class="tag">可住 24 人</span>
                <span class="tag">大型場地</span>
              </div>
            </div>
          </div>
        )}

        {items?.find(i => i.name.includes('大巴')) && (
          <div class="accommodation-card fade-in flex flex-col h-full">
            <div class="w-full h-48 md:h-[250px] overflow-hidden rounded-t-xl">
              {getImageUrls('六人大巴露營車').length > 0 ? (
                <ImageCarousel client:visible images={getImageUrls('六人大巴露營車')} alt="六人大巴露營車" className="w-full h-full" />
              ) : (
                <img src="/images/rooms/bus.jpeg" alt="六人大巴露營車" style="width: 100%; height: 100%; object-fit: cover;">
              )}
            </div>
            <div class="card-body flex-1">
              <h3>🚌 六人大巴露營車</h3>
              <p>免裝備豪華露營體驗！車內配有雙人床與沙發床，並設有獨立衛浴、冷氣等設施，讓您輕鬆享受大自然。</p>
              <div class="tags">
                <span class="tag">可住 6 人</span>
                <span class="tag">獨立衛浴</span>
                <span class="tag">冷氣</span>
                <span class="tag">含早餐</span>
              </div>
            </div>
          </div>
        )}

        {items?.find(i => i.name.includes('包棟')) && (
          <div class="accommodation-card fade-in flex flex-col h-full">
            <div class="w-full h-48 md:h-[250px] overflow-hidden rounded-t-xl">
              {getImageUrls('十人包棟').length > 0 ? (
                <ImageCarousel client:visible images={getImageUrls('十人包棟')} alt="十人包棟" className="w-full h-full" />
              ) : (
                <img src="/images/rooms/house.jpeg" alt="十人包棟" style="width: 100%; height: 100%; object-fit: cover;" />
              )}
            </div>
            <div class="card-body flex-1">
              <h3>🏠 十人包棟</h3>
              <p>大家族或三五好友出遊首選！專屬的包棟空間，內有5張雙人床，並提供冷氣與完善的衛浴設備。</p>
              <div class="tags">
                <span class="tag">可住 10 人</span>
                <span class="tag">冷氣</span>
                <span class="tag">含早餐</span>
              </div>
            </div>
          </div>
        )}

        {missingCampsites.map((item: any) => {
          const dbImages = item.image_url ? item.image_url.split(',').map((u: string) => u.trim()).filter(Boolean) : [];
          const mappedImages = (roomImagesMap as any)[item.name] || [];
          const images = dbImages.length > 0 ? dbImages : mappedImages;

          if (images.length === 0) return null;

          return (
            <div class="accommodation-card fade-in flex flex-col h-full">
              <div class="w-full h-48 md:h-[250px] overflow-hidden rounded-t-xl bg-slate-100 flex items-center justify-center">
                <ImageCarousel client:visible images={images} alt={item.name} className="w-full h-full" />
              </div>
              <div class="card-body flex-1">
                <h3>⛺ {item.name.replace('住宿-', '').replace('上營區-', '').replace('下營區-', '')}</h3>
                <p>{item.description || '體驗不遠山莊的自然之美與舒適設施。'}</p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 設施介紹 -->
  <section class="section" id="facilities">
    <div class="container">
      <h2 class="section-title">設施與服務</h2>
      <p class="section-subtitle">完善的設施，讓您的露營體驗更加舒適</p>
      
      <div class="campsite-features">
        <div class="feature-card fade-in">
          <div class="icon">🚿</div>
          <h4>公共衛浴</h4>
          <p>全區多處衛浴設施，提供沐浴乳、洗髮精、吹風機、衛生紙。上營區衛浴較新穎寬敞。</p>
        </div>
        <div class="feature-card fade-in">
          <div class="icon">🎪</div>
          <h4>滑草區</h4>
          <p>天然坡度滑草場，大人小孩都能享受速度與歡笑。</p>
        </div>
        <div class="feature-card fade-in">
          <div class="icon">🤸</div>
          <h4>跳跳床</h4>
          <p>大型彈跳床，讓孩子們盡情放電，大人也玩瘋了！</p>
        </div>
        <div class="feature-card fade-in">
          <div class="icon">🏊</div>
          <h4>充氣滑水道泳池</h4>
          <p>夏季限定！下營區放置超大型充氣滑水道泳池，消暑必備。</p>
        </div>
        <div class="feature-card fade-in">
          <div class="icon">🌺</div>
          <h4>蓮花池</h4>
          <p>靜謐的蓮花池畔，早上還能看到紅面番鴨出來散步，超可愛！</p>
        </div>
        <div class="feature-card fade-in">
          <div class="icon">☕</div>
          <h4>鹿角咖啡吧</h4>
          <p>由復古巴士改造的森林系咖啡廳，提供精緻下午茶、炸物、飲品。</p>
        </div>
        <div class="feature-card fade-in">
          <div class="icon">🧒</div>
          <h4>兒童遊戲區</h4>
          <p>沙坑、鞦韆、溜滑梯、單槓，讓孩子們玩到不想回家。</p>
        </div>
        <div class="feature-card fade-in">
          <div class="icon">🥾</div>
          <h4>健行步道</h4>
          <p>營區周邊有自然步道，適合晨間散步，還能走到吊橋賞景。</p>
        </div>
        <div class="feature-card fade-in">
          <div class="icon">🌸</div>
          <h4>賞櫻賞螢</h4>
          <p>春季櫻花盛開、夏季螢火蟲飛舞，四季皆有不同自然美景。</p>
        </div>
        <div class="feature-card fade-in">
          <div class="icon">🔥</div>
          <h4>營火區</h4>
          <p>夜晚營火晚會，劈啪作響的火星伴隨著溫暖的火光，氣氛滿分。</p>
        </div>
        <div class="feature-card fade-in">
          <div class="icon">🐕</div>
          <h4>寵物友善</h4>
          <p>超大坪數場地，毛孩可以自由活動奔跑（請務必繫繩並清理便便）。</p>
        </div>
        <div class="feature-card fade-in">
          <div class="icon">🅿️</div>
          <h4>免費停車場</h4>
          <p>附設免費停車場，也可停放大型遊覽車，車位充足。</p>
        </div>
      </div>

      <!-- 鹿角咖啡特寫 -->
      <div class="cafe-highlight fade-in" style="margin-top: 80px;">
        <div class="cafe-grid">
          <div class="cafe-content" style="text-align: left;">
            <h3 style="color: var(--primary-dark); font-size: 2rem; margin-bottom: 16px; display: flex; align-items: center; gap: 12px;">
              ☕ 鹿角 Café (森林系巴士咖啡廳)
            </h3>
            <p style="color: var(--text-light); line-height: 1.8; margin-bottom: 20px; font-size: 1.1rem;">
              隱身於不遠山莊內的魔幻秘境！由退役巴士改造而成，車體內外種滿了鹿角蕨與各式觀葉植物。在充滿綠意的森林包圍下，點一杯香醇咖啡與精緻甜點，享受悠閒的午後時光。
            </p>
            <ul style="color: var(--text-light); line-height: 2.2; margin-bottom: 24px; list-style: none; padding: 0;">
              <li><strong>📍 位置：</strong> 位於營區內部，步行即可抵達</li>
              <li><strong>⏰ 營業時間：</strong> 12:00–17:00 (週一至週三公休)</li>
              <li><strong>🌿 特色：</strong> 滿滿植栽佈置、精緻甜點、拉花咖啡</li>
            </ul>
          </div>
          <div class="cafe-images">
            <img src="/images/antler_cafe_bus.png" alt="鹿角咖啡巴士外觀" class="cafe-img img-main" />
            <img src="/images/antler_cafe_coffee.png" alt="鹿角咖啡甜點特寫" class="cafe-img img-offset" />
