---
// 之後如果有 Google AdSense，可以直接在這裡切換或是使用 Adsense 程式碼
// 目前顯示 o'rest 側睡記憶枕 聯盟網廣告

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

// 請將此處替換為您的聯盟網推廣專屬連結
const affiliateLink = "https://www.orest.com.tw/products/sidepillw"; 
---

<div class={`ad-container ${className}`}>
  <!-- 未來可替換為 Google AdSense 程式碼 -->
  <!-- <ins class="adsbygoogle" ...></ins> -->
  
  <a href={affiliateLink} target="_blank" rel="noopener noreferrer" class="ad-link-wrapper">
    <div class="ad-content">
      <div class="ad-badge">贊助廣告</div>
      <div class="ad-flex">
        <div class="ad-image-wrapper">
          <img 
            src="https://www.orest.com.tw/wp-content/uploads/2021/04/%E5%81%B4%E7%9D%A1%E8%A8%98%E6%86%B6%E6%9E%95-1-1-600x600.jpg" 
            alt="o'rest 側睡記憶枕" 
            class="ad-image"
            loading="lazy"
          />
        </div>
        <div class="ad-text">
          <h4 class="ad-title">o'rest 側睡記憶枕</h4>
          <p class="ad-description">
            三層針織布柔軟親膚，德國技術 100D 記憶綿，慢回彈優秀釋壓。給您舒適的支撐，不論正睡或側睡都好眠！全程 100% 台灣製造，抗菌防霉好安心。
          </p>
          <span class="ad-action">了解詳情 &rarr;</span>
        </div>
      </div>
    </div>
  </a>
</div>

<style>
  .ad-container {
    width: 100%;
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
    box-sizing: border-box;
  }
  
  .ad-link-wrapper {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 12px;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
    transition: all 0.3s ease;
    position: relative;
  }

  .ad-link-wrapper:hover {
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    transform: translateY(-2px);
    border-color: #cbd5e1;
  }

  .ad-badge {
    position: absolute;
    top: 0;
    right: 0;
    background: rgba(0, 0, 0, 0.06);
    color: #64748b;
    font-size: 0.7rem;
    padding: 2px 8px;
    border-bottom-left-radius: 8px;
    z-index: 10;
  }

  .ad-flex {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 640px) {
    .ad-flex {
      flex-direction: row;
      align-items: center;
    }
  }

  .ad-image-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #f8fafc;
    border-bottom: 1px solid #f1f5f9;
  }

  @media (min-width: 640px) {
    .ad-image-wrapper {
      width: 200px;
      aspect-ratio: 1 / 1;
      border-bottom: none;
      border-right: 1px solid #f1f5f9;
      flex-shrink: 0;
    }
  }

  .ad-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ad-text {
    padding: 1.25rem;
    flex-grow: 1;
  }

  .ad-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: #1e293b;
    margin: 0 0 0.5rem 0;
  }

  .ad-description {
    font-size: 0.875rem;
    color: #475569;
    line-height: 1.5;
    margin: 0 0 0.75rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ad-action {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 500;
    color: #2563eb;
  }
</style>
