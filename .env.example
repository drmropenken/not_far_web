# Supabase public API
PUBLIC_SUPABASE_URL="your-supabase-url"
PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Gmail SMTP credentials for Nodemailer
GMAIL_USER="your-gmail@gmail.com"
GMAIL_APP_PASSWORD="your-app-password"

# ECPay settings
ECPAY_ENDPOINT="https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5"
ECPAY_MERCHANT_ID="your-merchant-id"
ECPAY_HASH_KEY="your-hash-key"
ECPAY_HASH_IV="your-hash-iv"
ECPAY_RETURN_URL="https://your-domain.com/api/ecpay-webhook"
ECPAY_CLIENT_BACK_URL="https://your-domain.com/booking-success"